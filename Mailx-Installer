send_test_message() {
    if ! dpkg -l | grep -q mailutils; then
        apt-get update && apt-get install -y mailutils
    fi

    local email_to=$1
    local email_subject=$2
    local email_body=$3
    local email_domain=$(cat /usr/local/roundcube_mail_domain.txt 2>/dev/null | tr -d '[:space:]')
    [ -z "$email_domain" ] && email_domain="localhost"

    echo -e "$email_body" | mail -s "$email_subject" -a "From: admin@$email_domain" "$email_to" 2>/dev/null || true
    log_info "Test mail sent to $email_to"
}

uninstall_roundcube() {
    local MYSQL_ROOT_PASSWORD=$(cat /usr/local/mysql_root_pwd.txt 2>/dev/null || echo "")

    if [ -n "$MYSQL_ROOT_PASSWORD" ]; then
