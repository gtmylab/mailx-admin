        while true; do
            read -p "Please enter the email domain (e.g., example.com): " EMAIL_DOMAIN
            read -p "Please enter the system hostname (e.g., mail.example.com): " HOSTNAME
            read -p "Please enter the mail hostname / MX target [blank = same as system hostname]: " MAIL_HOSTNAME
            read -p "Please enter the admin email address: " ADMIN_MAILX_EMAIL
            echo

            if [[ -z "$EMAIL_DOMAIN" || -z "$HOSTNAME" || -z "$ADMIN_MAILX_EMAIL" ]]; then
                log_error "All fields are mandatory. Please provide values for all."
                continue
            fi

            if [[ ! "$HOSTNAME" =~ ^[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}$ ]]; then
                log_error "'$HOSTNAME' is not a fully qualified domain name."
