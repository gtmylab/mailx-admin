LOG_DIR="/var/log/mailx"
LOG_FILE="$LOG_DIR/installation.log"
TIMESTAMP=$(date +%Y%m%d_%H%M%S)

# Create necessary directories
mkdir -p "$STATE_DIR" "$LOG_DIR"

# Enable logging
exec > >(tee -a "$LOG_FILE") 2>&1

# Color codes for output
