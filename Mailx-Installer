    echo ""
}

manage_ssl_certificates() {
    local action=$1
    local hostname=$2
    local email_domain=$3
    local mail_hostname=$4

    if [ -z "$hostname" ]; then
        hostname=$(cat /etc/mailname 2>/dev/null | tr -d '[:space:]')
        hostname="${hostname:-$(hostname -f 2>/dev/null || hostname)}"
    fi
    if [ -z "$email_domain" ]; then
        email_domain=$(cat /usr/local/roundcube_mail_domain.txt 2>/dev/null | tr -d '[:space:]')
    fi
    if [ -z "$mail_hostname" ]; then
        mail_hostname=$(cat /usr/local/roundcube_mail_hostname.txt 2>/dev/null | tr -d '[:space:]')
    fi

    local webroot="/var/www/html"
    # The certificate is named after the system hostname; configure_ssl_services
    # and install_admin_apache_vhost look it up at /etc/letsencrypt/live/<hostname>.
    local cert_name="$hostname"

    if [ -z "$hostname" ] || [ -z "$email_domain" ]; then
        log_error "No hostname/domain specified for SSL certificate"
        return 1
    fi

    case "$action" in
        install)
            if [ -d "/etc/letsencrypt/live/$cert_name" ]; then
                log_info "SSL certificate already installed for $cert_name"
                configure_ssl_services "$cert_name"
                return 0
            fi

            if ! command -v certbot &> /dev/null; then
                log_info "Installing certbot..."
                apt_install certbot python3-certbot-apache
            fi

            mkdir -p "$webroot/.well-known/acme-challenge"
            chown -R www-data:www-data "$webroot"

            log_info "Attempting to install Let's Encrypt SSL certificate for $cert_name..."

            # SANs: system hostname + admin.<domain> + <domain> + optional mail host.
            if retry_command "certbot certonly --webroot -w $webroot $(cert_domains "$hostname" "$email_domain" "$mail_hostname") --non-interactive --agree-tos --email admin@$email_domain --keep-until-expiring"; then
                configure_ssl_services "$cert_name"
                setup_ssl_renewal
                log_info "SSL certificate installed successfully"
                return 0
            else
                log_warning "SSL cert with admin.<domain> failed — trying without admin SAN"
                if retry_command "certbot certonly --webroot -w $webroot $(cert_domains "$hostname" "$email_domain" "$mail_hostname" 0) --non-interactive --agree-tos --email admin@$email_domain --keep-until-expiring"; then
                    configure_ssl_services "$cert_name"
                    setup_ssl_renewal
                    log_info "SSL certificate installed (without admin SAN)"
                    return 0
                fi
                log_error "Failed to obtain SSL certificate"
                return 1
            fi
            ;;

        renew)
            log_info "Renewing SSL certificates..."
            certbot renew --quiet --post-hook "systemctl reload postfix dovecot apache2" || true
            ;;

        change)
            if [[ -z "$hostname" || -z "$email_domain" ]]; then
                log_error "New hostname/domain not specified"
                return 1
            fi

            log_info "Changing SSL certificate to $hostname (domain $email_domain)..."
            certbot certonly --webroot -w "$webroot" \
                $(cert_domains "$hostname" "$email_domain" "$mail_hostname") \
                --non-interactive --agree-tos --email admin@$email_domain \
                --keep-until-expiring --force-renewal || true

            configure_ssl_services "$hostname"
            ;;

        *)
            log_error "Usage: manage_ssl_certificates [install|renew|change hostname email_domain [mail_hostname]]"
            return 1
            ;;
    esac
}

# ============================================================================
# User Management
# ============================================================================

# ----------------------------------------------------------------------------
# Register a mailbox in the panel.
#
# "Add MailX User" creates a Unix account, a maildir and a quota note. That is
# half a mailbox: the panel — which owns /etc/dovecot/users and
# /etc/postfix/{virtual,vmailbox} and rewrites them from its database on every
# sync — has to know about it, or the mailbox does not appear in the UI and the
# next sync deletes the line this script used to append to /etc/postfix/virtual.
#
# So the account is registered through the panel's own write path
# (`mailbox add --kind system`), which reads the uid/gid/home from /etc/passwd,
# so the Unix login keeps working exactly as it did and the panel stops ignoring
# the account.
#
# The password is handed over too (--password-stdin) rather than letting the
# panel adopt the /etc/shadow hash. That is the whole point of the argument: a
# {CRYPT} shadow hash is one the host's crypt() only sometimes checks — a
# yescrypt ($y$) hash, which current distributions write by default, is refused
# with an internal failure rather than a wrong password, and the mailbox then
# cannot log in however right the password is. Given the plaintext, the panel
# writes a hash it has asked the local Dovecot about and, because `mailbox add`
# reconciles inline, proves the login before it answers.
# ----------------------------------------------------------------------------
register_mailbox_in_panel() {
    local email=$1
    local quota_size=${2:-1024}
    local password=${3:-}

    if [ ! -x "$ADMIN_BINARY_PATH" ] || [ ! -f "$ADMIN_CONFIG_FILE" ]; then
        # Fresh install: the panel is staged after this point. The account and
        # its maildir are ready, and the install's seed step imports every
        # /home/<user>/Maildir mailbox it finds, so nothing is lost — but that
        # import has no plaintext and keeps the account's /etc/shadow hash, so
        # say what to do if webmail refuses it later.
        log_info "Panel not installed yet — $email will be imported (with its /etc/shadow hash) when the panel is seeded"
        log_info "If webmail refuses $email after the install, set its password again in the panel (Users)"
        return 0
    fi

    # The panel refuses a plaintext password shorter than 8 characters (its rule
    # for every mailbox it creates). Adopting the shadow hash is the older,
    # weaker path; take it rather than refusing to register the account at all.
    if [ ${#password} -lt 8 ]; then
        if [ -n "$password" ]; then
            log_warning "Password for $email is shorter than the panel's 8-character minimum"
            log_warning "Registering it with its /etc/shadow hash instead; re-set the password in the panel to be sure of the login"
        fi
        password=""
    fi

    # Every call is an `if` condition, never a bare assignment: hide_output
    # leaves `set -e` on, and a panel command that fails must reach the warning
    # below rather than abort the install.
    local out registered=0
    if [ -n "$password" ]; then
        if out=$(printf '%s\n' "$password" | "$ADMIN_BINARY_PATH" mailbox add "$email" \
                    --kind system --quota "$quota_size" --password-stdin \
                    --config "$ADMIN_CONFIG_FILE" 2>&1); then
            registered=1
        fi
    else
        if out=$("$ADMIN_BINARY_PATH" mailbox add "$email" \
                    --kind system --quota "$quota_size" \
                    --config "$ADMIN_CONFIG_FILE" 2>&1); then
            registered=1
        fi
    fi

    if [ "$registered" -eq 1 ]; then
        echo "$out" | tee -a "$LOG_FILE"
        log_info "Mailbox $email registered in the panel"
        return 0
    fi

    echo "$out" | tee -a "$LOG_FILE"
    log_warning "Could not register $email in the panel."
    log_warning "The Unix account and its maildir are fine. Finish with:"
    log_warning "    mailx-admin mailbox add $email --kind system --password-stdin --config $ADMIN_CONFIG_FILE"
    log_warning "    (pipe the account's password in on standard input)"
    return 1
}

# verify_login — prove that the credentials just handed out actually log in.
#
# Why this exists: v1.0.9 shipped a webmail regression that only its users could
# see, because nothing in the installer or in the panel ever performed a login.
# `doveadm auth test` runs the same passdb/userdb lookup Dovecot performs for
# IMAP, so a password hashed with a scheme this Dovecot cannot verify, a mailbox
# missing from the passwd-file, and a locked account all surface here — in the
# install log, with the reason — instead of as "login failed" in webmail.
#
# It never fails the install: the account is sound once the cause is fixed, and
# the admin account this runs for must not abort an otherwise good run.
verify_login() {
    local address=$1
    local password=$2

    if ! command -v doveadm >/dev/null 2>&1; then
        log_warning "doveadm not found, cannot verify the login for $address"
        return 2
    fi

    local out
    if out=$(doveadm auth test "$address" "$password" 2>&1); then
        echo "$out" | tee -a "$LOG_FILE"
        log_info "Login verified: $address authenticates against Dovecot"
        return 0
    fi

    echo "$out" | tee -a "$LOG_FILE"
    log_error "LOGIN VERIFICATION FAILED for $address - webmail will refuse this account."
    log_error "Check, in this order:"
    log_error "  1. doveadm pw -l                 what this Dovecot can verify"
    log_error "  2. grep '^$address' /etc/dovecot/users    is the mailbox in the passwd file"
    log_error "  3. $ADMIN_BINARY_PATH doctor     hash scheme, passwd file, Roundcube"
    return 1
}

add_roundcube_user() {
    local username=$1
    local password=$2
    local quota_size=$3
    local domain=$(cat /usr/local/roundcube_mail_domain.txt 2>/dev/null | tr -d '[:space:]')
    local email="$username@$domain"
    local ROUNDCUBE_DB_USER="roundcube"
    local ROUNDCUBE_DB_NAME="roundcubemail"

    if id "$username" >/dev/null 2>&1; then
        log_info "User $username already exists, skipping creation..."
        # The account may predate the panel (or this release). Make sure the
        # panel knows about it instead of returning silently.
        register_mailbox_in_panel "$email" "$quota_size" "$password" || true
        return 0
    fi

    useradd -m -s /bin/bash "$username"
    echo "$username:$password" | chpasswd

    mkdir -p "/home/$username/Maildir/"{cur,new,tmp}
    chown -R "$username:$username" "/home/$username/Maildir"

    echo "quota_rule = *:storage=${quota_size}M" > "/home/$username/.dovecot.quota"
    chown "$username:$username" "/home/$username/.dovecot.quota"

    register_mailbox_in_panel "$email" "$quota_size" "$password" || true

    # Written under the bare UNIX user name, as in v1.0.8. It is cosmetic for
    # logging in — Roundcube creates its own row whenever this lookup misses, and
    # this release sets no username_domain to complete a bare name into an
    # address — so a login arrives as the full address (test1@$domain, which is
    # what the passwd-file is keyed by and what verify_login proves) and this row
    # carries the preferences for it. Whether the row should instead be keyed by
    # the address, as the panel's own seeder does, is the one thing here left to
    # the login test rather than a guess.
    ROUNDCUBE_PREFERENCE='a:6:{s:14:"compose_extwin";i:1;s:10:"htmleditor";i:1;s:11:"mdn_default";b:0;s:11:"dsn_default";b:0;s:13:"sig_separator";b:0;s:25:"compose_save_localstorage";i:1;}'

    USER_ID=$(mysql $ROUNDCUBE_DB_NAME -se "INSERT INTO users (username, mail_host, created, last_login, language, preferences) VALUES ('$username', 'localhost', NOW(), NOW(), 'en_GB', '$ROUNDCUBE_PREFERENCE'); SELECT LAST_INSERT_ID();" 2>/dev/null || echo "")

    if [ -n "$USER_ID" ]; then
        mysql $ROUNDCUBE_DB_NAME -e "INSERT INTO identities (user_id, changed, del, standard, name, organization, email, \`reply-to\`, signature, html_signature) VALUES ('$USER_ID', NOW(), '0', '1', '$username', 'localhost', '$email', '$email', '', '1');" 2>/dev/null || true
    fi

    systemctl restart postfix dovecot 2>/dev/null || true

    # Never hand out credentials without proving they work: this check is what
    # was missing when the v1.0.9 webmail regression reached users.
    verify_login "$email" "$password" || true

    send_welcome_email "$email" "$username"

    log_info "User $username created successfully with email $email"
}

send_welcome_email() {
    local recipient_email=$1
    local roundcube_user=$2
    local domain=$(cat /usr/local/roundcube_mail_domain.txt 2>/dev/null | tr -d '[:space:]')
    [ -z "$domain" ] && domain="localhost"

    local subject="Welcome to Roundcube Webmail, $roundcube_user"
    # The login is the whole address, and a different value from the account name
    # above: /etc/dovecot/users is keyed by the address, and this release sets no
    # username_domain to complete a bare name into one, so printing the bare name
    # as the login sent users to a name Dovecot refuses. It is also the value
    # verify_login has just tested.
    local body="Dear User,\n\nCongratulations! Your Roundcube email has been successfully set up.\n\nHere are your login details:\n\nWebmail login: $recipient_email\n\nYou can access your Roundcube webmail interface anytime\n\nThank you,\nAdmin Team"

    echo -e "$body" | mail -s "$subject" -a "From: admin@$domain" "$recipient_email" 2>/dev/null || true
}

