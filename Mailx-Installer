# Write /etc/mailx/admin.toml based on the chosen DB driver.
write_admin_toml() {
    local email_domain=$1
    local hostname=$2

    mkdir -p "$ADMIN_CONFIG_DIR"
    chmod 700 "$ADMIN_CONFIG_DIR"

    cat > "$ADMIN_CONFIG_FILE" <<EOF
# MailX Admin configuration
# Generated by installer on $(date -Iseconds)
# Edit carefully — the panel reads this on every start.

[server]
listen_addr = "${ADMIN_LISTEN_ADDR}"
base_url    = "https://admin.${email_domain}"
hostname    = "${hostname}"

[database]
driver = "sqlite"

[database.sqlite]
path = "${ADMIN_STATE_DB}"

[database.postgres]
host     = "127.0.0.1"
port     = 5432
user     = "mailx_admin"
password = ""
dbname   = "mailx_admin"
sslmode  = "disable"

[mail]
postfix_conf_dir    = "/etc/postfix"
dovecot_conf_dir    = "/etc/dovecot"
opendkim_dir        = "/etc/opendkim"
primary_domain_file = "/usr/local/roundcube_mail_domain.txt"
# Which scheme new mailbox passwords are hashed with. "auto" asks the local
# Dovecot (doveadm pw -l): ARGON2ID where it was built with libsodium, SSHA512
# where it was not. A hard-coded ARGON2ID on a Dovecot without libsodium is a
# mailbox that can never log in.
passwd_scheme       = "auto"

[roundcube]
# Pre-seed Roundcube's own database (a users row and its default identity) for
# every mailbox the panel creates, so webmail knows the account before its owner
# first logs in. Roundcube would create the rows itself at first login; doing it
# here is what makes "does webmail know about this mailbox?" answerable.
enabled   = true
database  = "roundcubemail"
# The MySQL client reads the Roundcube DB credentials from this defaults file,
# which lives outside /root because the panel's systemd unit sets ProtectHome=yes.
binary    = "mysql"
args      = ["--defaults-file=/etc/mailx/roundcube.my.cnf"]
# Has to match Roundcube's imap_host/default_host, or the row written here is
# not the one a login looks up.
mail_host = "localhost"
language  = "en_GB"

[dns]
resolver = "1.1.1.1:53"

[logs]
mail_log_path  = "/var/log/mail.log"
retention_days = 30
EOF
    chmod 600 "$ADMIN_CONFIG_FILE"
}

# Ensure the panel systemd unit exists and is configured.
install_admin_systemd_unit() {
    cat > "/etc/systemd/system/${ADMIN_SERVICE_NAME}.service" <<EOF
[Unit]
Description=MailX Admin Panel
Documentation=https://github.com/gtmylab/mailx-admin
After=network.target postfix.service dovecot.service
Wants=postfix.service dovecot.service

[Service]
Type=simple
User=root
Group=root
ExecStart=${ADMIN_BINARY_PATH} serve --config ${ADMIN_CONFIG_FILE} --require-seed
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mailx-admin

ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable "${ADMIN_SERVICE_NAME}" 2>/dev/null || true
}

# ============================================================================
# Admin panel web access helpers
# ============================================================================

# Make Apache bind a TCP port. A <VirtualHost *:9443> block alone does NOT make
# Apache listen on 9443: without a matching Listen directive the port stays
# closed while "apache2ctl configtest" still reports Syntax OK and the reload
# succeeds, so the installer used to advertise https://admin.<domain>:9443 while
# every browser got ERR_CONNECTION_REFUSED. ports.conf (installed in Stage 5)
# declares 80/443/8080-8084/8443 only, so the panel port is registered here.
ensure_apache_listen_port() {
    local port=$1
    local conf="/etc/apache2/conf-available/mailx-admin-port.conf"
    local pattern="^[[:space:]]*Listen[[:space:]]+${port}([[:space:]]|$)"

    if grep -qsE "$pattern" /etc/apache2/ports.conf 2>/dev/null; then
        # ports.conf already covers the port, so drop our snippet to keep the
        # port declared exactly once (e.g. after an installer update that adds
        # the panel port to the shipped ports.conf).
        if [ -e /etc/apache2/conf-enabled/mailx-admin-port.conf ] || \
           [ -L /etc/apache2/conf-enabled/mailx-admin-port.conf ]; then
            a2disconf mailx-admin-port > /dev/null 2>&1 || true
            # -L above covers a dangling symlink: remove it explicitly so
            # "IncludeOptional conf-enabled/*.conf" cannot hit a broken link.
            rm -f /etc/apache2/conf-enabled/mailx-admin-port.conf
            rm -f "$conf"
            log_info "ports.conf already declares port ${port} — removed the panel snippet"
        fi
        log_info "Apache already listens on port ${port}"
        return 0
    fi

    if grep -rsqE "$pattern" /etc/apache2/conf-enabled 2>/dev/null; then
        log_info "Apache already listens on port ${port}"
        return 0
    fi

    cat > "$conf" <<EOF
# MailX Admin panel port — required by <VirtualHost *:${port}> in
# sites-available/mailx-admin.conf. Added automatically because ports.conf
# (80/443/8080-8084/8443) does not declare it.
Listen ${port}
EOF

    a2enconf mailx-admin-port > /dev/null 2>&1 || true
    log_info "Enabled Apache listen port ${port} via ${conf}"
}

# Open $1/tcp in whichever firewall is installed. No-op when there is none.
open_firewall_port() {
    local port=$1

    if command -v ufw &>/dev/null && ufw status 2>/dev/null | grep -qi '^Status: active'; then
        ufw allow "${port}"/tcp 2>/dev/null || true
        log_info "ufw: allowed TCP ${port}"
    fi

    if command -v firewall-cmd &>/dev/null && systemctl is-active --quiet firewalld 2>/dev/null; then
        firewall-cmd --permanent --add-port="${port}"/tcp > /dev/null 2>&1 || true
        firewall-cmd --reload > /dev/null 2>&1 || true
        log_info "firewalld: allowed TCP ${port}"
    fi
}

# True when something (Apache) already listens on TCP $1.
port_is_listening() {
    ss -ltn 2>/dev/null | grep -qE "[:.]$1[[:space:]]"
}

# Wait for TCP $1 to appear, up to $2 tries (0.5s apart). Apache needs a moment
# after a restart before the new socket accepts, and the probe used to run
# immediately.
wait_for_listen_port() {
    local port=$1
    local tries=${2:-20}
    local i=0

    while [ "$i" -lt "$tries" ]; do
        if port_is_listening "${port}"; then
            return 0
        fi
        sleep 0.5
        i=$((i + 1))
    done
    return 1
}

# Apply the Apache configuration, restarting only when a reload cannot do the
# job. $1 = port that has to end up open.
#
# A graceful reload (SIGUSR1) re-reads the configuration but keeps the listener
# set of the running master process, so a Listen directive that was just added
# is NOT opened by it: configtest reports Syntax OK, the reload succeeds, and
# the port stays closed. Stage 14 used to reload unconditionally, which made a
# fresh install fail with "Nothing is listening on TCP 9443 after reloading
# Apache" even though conf mailx-admin-port was enabled. Restarting in that case
# is what actually opens the socket; when the port is already open (a re-run, or
# menu option 21) the reload is kept so nothing is interrupted.
apache_reload_for_port() {
    local port=$1

    if port_is_listening "${port}"; then
        systemctl reload apache2 2>/dev/null || systemctl restart apache2 2>/dev/null || true
        return 0
    fi

    log_info "TCP ${port} is not open yet — restarting Apache to apply the Listen directive"
    if systemctl restart apache2 2>/dev/null; then
        log_info "Apache restarted"
        return 0
    fi

    log_warning "systemctl restart apache2 failed — falling back to a graceful reload"
    systemctl reload apache2 2>/dev/null || true
}

# Prove that Apache really serves the panel before the installer advertises the
# URL. $1 = port, $2 = vhost ServerName (e.g. admin.example.com).
verify_admin_panel_web() {
    local port=$1
    local server_name=$2

    if ! wait_for_listen_port "${port}"; then
        log_error "Nothing is listening on TCP ${port} after restarting Apache"
        return 1
    fi
    log_info "Apache is listening on TCP ${port}"

    if ! command -v curl &>/dev/null; then
        log_warning "curl is not installed — skipping the local HTTPS probe"
        return 0
    fi

    local code
    code=$(curl -ksS -o /dev/null -w '%{http_code}' --max-time 15 \
        --resolve "${server_name}:${port}:127.0.0.1" \
        "https://${server_name}:${port}/" 2>/dev/null || true)

    if [ -z "$code" ] || [ "$code" = "000" ]; then
        log_error "The admin vhost did not answer on https://${server_name}:${port}/"
        return 1
    fi

    log_info "Panel answered through Apache (HTTP ${code})"

    # The probe above passes with -k, so it cannot tell a trusted certificate
    # from a hostname mismatch. SSL setup tries to include admin.<domain> in the
    # SANs but retries without it when that fails, and a certificate missing the
    # panel name leaves the port answering while every browser shows a TLS
    # warning. Report it (a warning, not a failure) so the log states the truth.
    if curl -sS -o /dev/null --max-time 15 \
            --resolve "${server_name}:${port}:127.0.0.1" \
            "https://${server_name}:${port}/" > /dev/null 2>&1; then
        log_info "TLS certificate is valid for ${server_name}"
    else
        log_warning "TLS certificate does not cover ${server_name} — browsers will show a warning"
        log_warning "Fix: certbot --apache -d ${server_name} (then re-run menu option 21)"
    fi

    return 0
}

# Print the facts needed to debug a panel that is not reachable from outside.
show_admin_panel_diagnostics() {
    local port=$1
    local listeners

    listeners=$(ss -ltn 2>/dev/null | grep -E "[:.]${port}[[:space:]]" | tr -s ' ' | tr '\n' ' ')

    echo ""
    echo "=============================================="
    echo "   Admin panel diagnostics (TCP ${port})"
    echo "=============================================="
    echo "  listeners:  ${listeners:-nothing on TCP ${port}}"
    echo "  apache2:    $(systemctl is-active apache2 2>/dev/null || echo unknown)"
    echo "  site:       $(a2query -s mailx-admin 2>/dev/null || echo 'mailx-admin not enabled')"
    echo "  conf:       $(a2query -c mailx-admin-port 2>/dev/null || echo 'mailx-admin-port not enabled')"
    echo "  ports.conf: $(grep -h 'Listen' /etc/apache2/ports.conf 2>/dev/null | tr '\n' ' ')"
    echo "  configtest: apache2ctl configtest"
    echo "  error log:  tail -n 30 /var/log/apache2/mailx-admin_error.log"
    echo "  apache log: journalctl -u apache2 -n 30 --no-pager"
    echo "  panel svc:  systemctl status ${ADMIN_SERVICE_NAME} --no-pager"
    echo "  firewall:   ufw status ; firewall-cmd --list-ports"
    echo "  TCP ${port} must also be allowed by your provider firewall."
    echo ""
}

# Write the Apache vhost for the panel (reverse proxy).
install_admin_apache_vhost() {
    local hostname=$1
    local email_domain=$2
    local server_name="admin.${email_domain}"
    local port="${ADMIN_WEB_PORT}"

    # proxy/proxy_http reverse-proxy the Go binary on ${ADMIN_LISTEN_ADDR},
    # ssl terminates TLS, headers writes HSTS. Show what a2enmod does: silently
    # swallowed module failures produced an installed-but-unusable vhost before.
    a2enmod proxy proxy_http ssl headers 2>&1 | grep -E 'Enabling module|already enabled' || true

    local cert_path="/etc/letsencrypt/live/${hostname}"
    if [ ! -f "${cert_path}/fullchain.pem" ] || [ ! -f "${cert_path}/privkey.pem" ]; then
        log_error "TLS certificate for ${hostname} is missing (${cert_path})"
        log_error "Obtain it with: certbot --apache -d ${hostname} -d ${server_name}"
        return 1
    fi

    cat > /etc/apache2/sites-available/mailx-admin.conf <<EOF
# MailX Admin Panel — generated by installer
# Reverse-proxies HTTPS to the Go binary on ${ADMIN_LISTEN_ADDR}

<VirtualHost *:${ADMIN_WEB_PORT}>
    ServerName admin.${email_domain}

    SSLEngine on
    SSLCertificateFile    ${cert_path}/fullchain.pem
    SSLCertificateKeyFile ${cert_path}/privkey.pem

    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    ProxyPreserveHost On
    ProxyRequests Off

    # Block external access to /metrics
    <Location /metrics>
        Require all denied
    </Location>

    # SSE endpoint — buffering off for live log tailing
    <Location /events>
        ProxyPass        http://${ADMIN_LISTEN_ADDR}/events
        ProxyPassReverse http://${ADMIN_LISTEN_ADDR}/events
        Header set X-Accel-Buffering no
        SetEnv proxy-sendchunked 1
        SetEnv proxy-sendcl 0
    </Location>

    ProxyPass        / http://${ADMIN_LISTEN_ADDR}/
    ProxyPassReverse / http://${ADMIN_LISTEN_ADDR}/

    ErrorLog \${APACHE_LOG_DIR}/mailx-admin_error.log
    CustomLog \${APACHE_LOG_DIR}/mailx-admin_access.log combined
</VirtualHost>
EOF

    # Apache ignores a <VirtualHost *:N> whose port has no Listen directive, so
    # register the panel port before enabling the site. Without this the vhost
    # is inert: configtest says Syntax OK, the reload succeeds and the URL still
    # refuses connections.
    ensure_apache_listen_port "${port}"

    a2ensite mailx-admin.conf > /dev/null 2>&1 || true

    if ! apache2ctl configtest > /tmp/mailx_apache_configtest.log 2>&1; then
        log_error "Apache rejected the admin vhost:"
        sed 's/^/    /' /tmp/mailx_apache_configtest.log
        return 1
    fi

    # A reload cannot open a port that was just added to the Listen set (see
    # apache_reload_for_port), which is exactly the state after
    # ensure_apache_listen_port above.
    apache_reload_for_port "${port}"

    open_firewall_port "${port}"

    verify_admin_panel_web "${port}" "${server_name}" || {
        show_admin_panel_diagnostics "${port}"
        return 1
    }

    return 0
}

# In-place upgrade: fetch the newest release binary (checksum-verified), back up
# the current one, run migrations and reconcile, then restart the service. This
# is the update path for an *already installed* server — it never runs the
# fresh-install stages (packages, Postfix/Dovecot config, Roundcube, SSL), so it
# is fast and leaves the existing config and data untouched.
update_mailx_admin() {
    log_info "=== Updating mailx-admin to the latest release ==="

    if [ ! -x "$ADMIN_BINARY_PATH" ] || [ ! -f "$ADMIN_CONFIG_FILE" ]; then
        log_error "mailx-admin is not installed ($ADMIN_BINARY_PATH or $ADMIN_CONFIG_FILE missing)."
        log_error "Run option 1 (Install MailX) first."
        return 1
    fi

    local old_version
    old_version=$("$ADMIN_BINARY_PATH" --version 2>/dev/null | head -n1 || echo unknown)

    mkdir -p "$ADMIN_BACKUP_DIR"
    rm -f "$ADMIN_BACKUP_DIR/mailx-admin.previous"
    if ! cp "$ADMIN_BINARY_PATH" "$ADMIN_BACKUP_DIR/mailx-admin.previous"; then
        log_error "Could not back up the current binary — refusing to update."
        return 1
    fi

    # A leftover /tmp/mailx-admin from an earlier offline install would otherwise
    # be preferred over a fresh download, pinning the "update" to a stale build.
    # Clear the *default* local path unless the operator explicitly supplied
    # their own build via MAILX_ADMIN_BINARY_LOCAL.
    if [ -z "$MAILX_ADMIN_BINARY_LOCAL" ]; then
        rm -f "$ADMIN_BINARY_LOCAL"
    fi

    # Fetch and verify the newest build. On failure the previous binary is still
    # at $ADMIN_BINARY_PATH, so the server keeps running the old release.
    if ! install_binary_from_url "$ADMIN_BINARY_URL" "$ADMIN_BINARY_LOCAL" "$ADMIN_BINARY_PATH" "$ADMIN_BINARY_ASSET" "$ADMIN_BINARY_SHA_URL"; then
        log_error "Could not download the new binary — the previous build is still in place."
        rm -f "$ADMIN_BACKUP_DIR/mailx-admin.previous"
        return 1
    fi
    chmod 0755 "$ADMIN_BINARY_PATH"

    local new_version
    new_version=$("$ADMIN_BINARY_PATH" --version 2>/dev/null | head -n1 || echo unknown)

    log_info "Running database migrations..."
    if ! "$ADMIN_BINARY_PATH" migrate --config "$ADMIN_CONFIG_FILE"; then
        log_error "Migration failed — restoring the previous binary."
        cp "$ADMIN_BACKUP_DIR/mailx-admin.previous" "$ADMIN_BINARY_PATH"
        chmod 0755 "$ADMIN_BINARY_PATH"
        return 1
    fi

    # Re-render Postfix/Dovecot config so it matches the new release's templates.
    "$ADMIN_BINARY_PATH" reconcile --config "$ADMIN_CONFIG_FILE" 2>&1 | tee -a "$LOG_FILE" || \
        log_warning "reconcile reported issues — run 'mailx-admin reconcile' manually later"

    systemctl restart "$ADMIN_SERVICE_NAME" || {
        log_error "mailx-admin failed to start after update. Check: journalctl -u ${ADMIN_SERVICE_NAME} -n 40"
        return 1
    }

    log_info "mailx-admin updated: $old_version -> $new_version"
    "$ADMIN_BINARY_PATH" --version
}

# Roundcube webmail vhost with SSL on 8080. Uses the Let's Encrypt certificate
# for the mail hostname when it exists (after Stage 8), otherwise a self-signed
# one so the vhost still starts before certbot has run.
write_roundcube_ssl_vhost() {
    local hostname=$1
    local cert_file key_file

    if [ -f "/etc/letsencrypt/live/${hostname}/fullchain.pem" ]; then
        cert_file="/etc/letsencrypt/live/${hostname}/fullchain.pem"
        key_file="/etc/letsencrypt/live/${hostname}/privkey.pem"
        log_info "Roundcube SSL: using Let's Encrypt certificate for ${hostname}"
    else
        mkdir -p /etc/ssl/roundcube
        if [ ! -f "/etc/ssl/roundcube/roundcube.crt" ]; then
            log_info "Generating a self-signed certificate for Roundcube (replaced by Let's Encrypt in Stage 8)..."
            openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
                -keyout /etc/ssl/roundcube/roundcube.key \
                -out /etc/ssl/roundcube/roundcube.crt \
                -subj "/CN=${hostname}" 2>/dev/null
        fi
        cert_file="/etc/ssl/roundcube/roundcube.crt"
        key_file="/etc/ssl/roundcube/roundcube.key"
        log_info "Roundcube SSL: using self-signed certificate for ${hostname}"
    fi

    cat <<EOF > /etc/apache2/sites-available/roundcube.conf
<VirtualHost *:8080>
    ServerName ${hostname}
    DocumentRoot /var/www/html/roundcube

    SSLEngine on
    SSLCertificateFile ${cert_file}
    SSLCertificateKeyFile ${key_file}

    <Directory /var/www/html/roundcube/>
        Options +FollowSymlinks
        AllowOverride All
        <IfModule mod_dir.c>
            DirectoryIndex index.php
        </IfModule>
    </Directory>
    <FilesMatch \.php\$>
        SetHandler "proxy:unix:/run/php/php8.4-fpm.sock|fcgi://localhost"
    </FilesMatch>
    ErrorLog \${APACHE_LOG_DIR}/roundcube_error.log
    CustomLog \${APACHE_LOG_DIR}/roundcube_access.log combined
</VirtualHost>
EOF

    a2enmod ssl > /dev/null 2>&1 || true
    a2ensite roundcube.conf > /dev/null 2>&1 || true
    systemctl reload apache2 2>/dev/null || true
}

# Stage 13 body — extracted so it can be called from the main stage runner.
install_mailx_admin_panel() {
    local EMAIL_DOMAIN=$1
    local HOSTNAME=$2

    log_info "=== Stage 13: MailX Admin Panel Installation ==="

    # ---- 13a. Prerequisites ----
    apt_install sqlite3 ca-certificates curl

    # ---- 13b. Database driver ----
    # SQLite is the default and needs no prompt: it suits a single server, and a
    # PostgreSQL upgrade is performed later from the panel (which migrates the
    # schema), not at install time.
    local admin_db_driver="sqlite"
    echo "$admin_db_driver" > "${STATE_DIR}/admin_db_driver"

    mkdir -p "$ADMIN_CONFIG_DIR" "$ADMIN_STATE_DIR" "$ADMIN_BACKUP_DIR"
    chmod 700 "$ADMIN_CONFIG_DIR" "$ADMIN_STATE_DIR"

    # ---- 13c. Write admin.toml ----
    log_info "Writing $ADMIN_CONFIG_FILE"
    write_admin_toml "$EMAIL_DOMAIN" "$HOSTNAME"

    # ---- 13e. Download & install the binary ----
    if [ -x "$ADMIN_BINARY_PATH" ] && [ -z "$MAILX_ADMIN_FORCE_REINSTALL" ]; then
        log_info "mailx-admin binary already present at $ADMIN_BINARY_PATH"
        log_info "Set MAILX_ADMIN_FORCE_REINSTALL=1 to replace it with the release build"
    else
        # Only $ADMIN_BINARY_ASSET (linux-amd64) is published. Installing it on
        # another architecture produces a binary that dies with "Exec format
        # error", so refuse early unless the operator supplied their own build
        # (MAILX_ADMIN_BINARY_URL=... or a file at $ADMIN_BINARY_LOCAL).
        local machine_arch
        machine_arch=$(uname -m)
        if [ "$machine_arch" != "x86_64" ] && [ -z "$MAILX_ADMIN_BINARY_URL" ] && [ ! -s "$ADMIN_BINARY_LOCAL" ]; then
            log_error "No mailx-admin release binary for '$machine_arch' (published asset is ${ADMIN_BINARY_ASSET})."
            log_error "Build from source, or set MAILX_ADMIN_BINARY_URL / MAILX_ADMIN_BINARY_LOCAL, then re-run."
            return 1
        fi

        if ! install_binary_from_url "$ADMIN_BINARY_URL" "$ADMIN_BINARY_LOCAL" "$ADMIN_BINARY_PATH" "$ADMIN_BINARY_ASSET" "$ADMIN_BINARY_SHA_URL"; then
            log_warning "Could not install mailx-admin binary — panel will not start."
            log_warning "Place the binary at $ADMIN_BINARY_LOCAL and re-run this stage."
            return 1
        fi
        log_info "Installed $ADMIN_BINARY_PATH"
    fi

    # Provenance: record exactly which build now sits on this host. Logged on
    # every run, not only fresh installs, because an existing binary is kept
    # as-is (and therefore stays version-pinned) unless
    # MAILX_ADMIN_FORCE_REINSTALL=1 forces a replacement.
    log_info "Installed version: $("$ADMIN_BINARY_PATH" --version 2>/dev/null || echo unknown)"

    # ---- 13f. Migrations ----
    log_info "Running database migrations..."
    if ! "$ADMIN_BINARY_PATH" migrate --config "$ADMIN_CONFIG_FILE"; then
        log_error "Database migration failed"
        # Step 13e keeps an already-installed binary as-is, so a host that has a
        # previous release keeps its bugs until it is replaced on purpose.
        if [ -z "$MAILX_ADMIN_FORCE_REINSTALL" ]; then
            log_warning "A previously installed release is kept as-is; re-run with MAILX_ADMIN_FORCE_REINSTALL=1 to fetch the newest build"
        fi
        return 1
    fi

    # ---- 13g. Seed ----
    log_info "Seeding admin DB from existing server configs..."
    "$ADMIN_BINARY_PATH" seed --config "$ADMIN_CONFIG_FILE" --yes 2>&1 | tee -a "$LOG_FILE" || \
        log_warning "Seed failed or was skipped — run 'mailx-admin seed' manually later"

    # ---- 13h. Initial admin user ----
    if ! "$ADMIN_BINARY_PATH" user list --config "$ADMIN_CONFIG_FILE" 2>/dev/null | grep -q admin; then
        local initial_admin_pw
        initial_admin_pw=$(generate_password 24)

        echo "$initial_admin_pw" | "$ADMIN_BINARY_PATH" user create admin \
            --config "$ADMIN_CONFIG_FILE" --role admin 2>&1 | tee -a "$LOG_FILE"

        echo "$initial_admin_pw" > /root/.mailx-admin-initial-password
        chmod 600 /root/.mailx-admin-initial-password
        log_info "Initial admin password saved to /root/.mailx-admin-initial-password"
    else
        log_info "Admin user already exists"
    fi

    # ---- 13i. systemd unit ----
    log_info "Installing systemd unit: ${ADMIN_SERVICE_NAME}.service"
    install_admin_systemd_unit

    systemctl restart "${ADMIN_SERVICE_NAME}" || {
        log_error "mailx-admin failed to start. Check: journalctl -u ${ADMIN_SERVICE_NAME} -n 40"
        return 1
    }

    # ---- 13j. Health check ----
    log_info "Waiting for mailx-admin to become responsive..."
    local waited=0
    while [ $waited -lt 20 ]; do
        if curl -sf "http://${ADMIN_LISTEN_ADDR}/login" >/dev/null 2>&1; then
            log_info "mailx-admin is responding on ${ADMIN_LISTEN_ADDR}"
            break
        fi
        sleep 1
        waited=$((waited + 1))
    done

    if [ $waited -ge 20 ]; then
        log_warning "mailx-admin did not respond within 20s — check journalctl -u ${ADMIN_SERVICE_NAME}"
    fi

    log_info "MailX Admin panel installed successfully"
}

# Stage 14 body — Apache vhost for the panel.
install_mailx_admin_vhost() {
    local EMAIL_DOMAIN=$1
    local HOSTNAME=$2

    log_info "=== Stage 14: Admin Panel Apache Vhost ==="

    if install_admin_apache_vhost "$HOSTNAME" "$EMAIL_DOMAIN"; then
        log_info "Admin vhost installed at https://admin.${EMAIL_DOMAIN}:${ADMIN_WEB_PORT}"
        log_info "If the URL does not open from your PC, allow TCP ${ADMIN_WEB_PORT} in the provider firewall"
        return 0
    fi

    log_error "Stage 14 could not verify https://admin.${EMAIL_DOMAIN}:${ADMIN_WEB_PORT}"
    log_error "Fix the cause printed above, then re-run menu option 21 (Repair Admin Panel Web Access)"
    return 1
}

# Menu option 21 — re-apply the panel vhost on an installed server. Needed
# because Stage 14 is skipped once its state marker exists, so servers installed
# before the Listen fix would never pick it up otherwise.
repair_admin_panel_web() {
    local email_domain hostname

    email_domain=$(cat /usr/local/roundcube_mail_domain.txt 2>/dev/null | tr -d '[:space:]')
    hostname=$(cat /etc/mailname 2>/dev/null | tr -d '[:space:]')
    hostname="${hostname:-$(hostname -f 2>/dev/null || hostname)}"

    if [ -z "$email_domain" ] && [ -t 0 ]; then
        read -p "Enter your email domain (e.g., example.com): " email_domain
    fi
    if [ -z "$email_domain" ]; then
        log_error "No email domain available: create /usr/local/roundcube_mail_domain.txt first"
        return 1
    fi

    echo ""
    echo "Domain:   $email_domain"
    echo "Hostname: $hostname"
    echo ""

    if install_admin_apache_vhost "$hostname" "$email_domain"; then
        log_info "Admin panel reachable through Apache at https://admin.${email_domain}:${ADMIN_WEB_PORT}"
        return 0
    fi

    log_error "Admin panel web access is still not working — see the diagnostics above"
    return 1
}

# ============================================================================
# Main Installation Function with Checkpoints
# ============================================================================

install_roundcube() {
    local EMAIL_DOMAIN=$1
    local HOSTNAME=$2
    local ADMIN_MAILX_EMAIL=$3

    # Stage 1: System Preparation
    if ! is_stage_completed "system_preparation"; then
        log_info "=== Stage 1: System Preparation ==="

        echo "$HOSTNAME" > /etc/hostname
        sed -i "s/127.0.0.1.*/127.0.0.1 localhost $HOSTNAME/" /etc/hosts
        hostnamectl set-hostname $HOSTNAME 2>/dev/null || true

        if [[ "$HOSTNAME" =~ ^[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}$ ]]; then
            echo "$HOSTNAME" | tee /etc/mailname > /dev/null
        fi

        apt-get -qq update > /dev/null

        mark_stage_complete "system_preparation"
    fi

    # Stage 2: MySQL Installation
    if ! is_stage_completed "mysql_installation"; then
        log_info "=== Stage 2: MySQL Installation ==="

        local MYSQL_ROOT_PASSWORD=$(cat /usr/local/mysql_root_pwd.txt)
        local ROUNDCUBE_DB_PASSWORD=$(cat /usr/local/roundcube_db_pwd.txt)
        local ROUNDCUBE_DB_USER="roundcube"
        local ROUNDCUBE_DB_NAME="roundcubemail"

        export DEBIAN_FRONTEND=noninteractive
        debconf-set-selections <<< "mysql-server mysql-server/root_password password $MYSQL_ROOT_PASSWORD"
        debconf-set-selections <<< "mysql-server mysql-server/root_password_again password $MYSQL_ROOT_PASSWORD"
        apt-get -qq install -y mysql-server > /dev/null

        cat <<EOF > ~/.my.cnf
[client]
user=root
password=$MYSQL_ROOT_PASSWORD
EOF
        chmod 600 ~/.my.cnf

        # The panel reads its MySQL credentials from here, not ~/.my.cnf: the
        # panel's systemd unit sets ProtectHome=yes, which hides /root, so
        # ~/.my.cnf is invisible to it and mysql falls back to "root with no
        # password" (access denied). Use the Roundcube user — the account that
        # only has rights to roundcubemail.* — and a path ProtectHome leaves
        # readable.
        mkdir -p /etc/mailx
        cat <<EOF > /etc/mailx/roundcube.my.cnf
[client]
user=$ROUNDCUBE_DB_USER
password=$ROUNDCUBE_DB_PASSWORD
EOF
        chmod 600 /etc/mailx/roundcube.my.cnf

        mysql -e "CREATE DATABASE IF NOT EXISTS $ROUNDCUBE_DB_NAME;" 2>/dev/null
        mysql -e "CREATE USER IF NOT EXISTS '$ROUNDCUBE_DB_USER'@'localhost' IDENTIFIED BY '$ROUNDCUBE_DB_PASSWORD';" 2>/dev/null
        mysql -e "GRANT ALL PRIVILEGES ON $ROUNDCUBE_DB_NAME.* TO '$ROUNDCUBE_DB_USER'@'localhost';" 2>/dev/null
        mysql -e "FLUSH PRIVILEGES;" 2>/dev/null

        mark_stage_complete "mysql_installation"
    fi

    # Stage 3: PHP and Basic Packages
    if ! is_stage_completed "php_installation"; then
        log_info "=== Stage 3: PHP and Basic Packages Installation ==="
        fix_network_for_ppa

        apt_install software-properties-common

        LC_ALL=C.UTF-8 add-apt-repository ppa:ondrej/php -y > /dev/null 2>&1
        apt-get -qq update > /dev/null

        log_info "Installing PHP 8.1..."
        apt_install php8.1 php8.1-fpm php8.1-cli php8.1-common php8.1-curl php8.1-mysql php8.1-pgsql php8.1-sqlite3 php8.1-xml php8.1-mbstring php8.1-zip php8.1-intl php8.1-pspell php8.1-ldap php8.1-gd php8.1-imagick php8.1-bz2 php8.1-gmp php8.1-bcmath php8.1-opcache php8.1-readline php8.1-xsl unzip
        log_info "Installing PHP 8.3..."
        apt_install php8.3 php8.3-fpm php8.3-cli php8.3-common php8.3-curl php8.3-mysql php8.3-xml php8.3-mbstring php8.3-zip php8.3-intl php8.3-pspell

        log_info "Installing PHP 8.4..."
        apt_install php8.4 php8.4-fpm php8.4-cli php8.4-common php8.4-curl php8.4-mysql php8.4-pgsql php8.4-sqlite3 php8.4-xml php8.4-mbstring php8.4-zip php8.4-intl php8.4-pspell php8.4-ldap php8.4-gd php8.4-imagick php8.4-bz2 php8.4-gmp php8.4-bcmath php8.4-opcache php8.4-readline php8.4-xsl unzip
        log_info "Installing PHP 5.6..."
        apt_install php5.6 php5.6-fpm php5.6-cli php5.6-common php5.6-curl php5.6-mysql php5.6-xml php5.6-mbstring php5.6-zip php5.6-intl php5.6-pspell

        mark_stage_complete "php_installation"
    fi

    # Stage 4: Mail Server Installation
    if ! is_stage_completed "mail_server_installation"; then
        log_info "=== Stage 4: Mail Server Installation ==="

        apt_install postfix net-tools mailutils dovecot-core dovecot-imapd dovecot-pop3d dovecot-mysql swaks

        configure_dovecot_quota
        configure_dovecot_sasl

        systemctl restart dovecot postfix 2>/dev/null || true

        verify_postfix_dovecot_connection
        test_sasl_authentication soft

        mark_stage_complete "mail_server_installation"
    fi

    # Stage 5: Apache Installation
    if ! is_stage_completed "apache_installation"; then
        log_info "=== Stage 5: Apache Installation ==="

        apt_install apache2 libapache2-mod-fcgid

        if [ ! -d "/etc/apache2" ]; then
            apt-get install --reinstall -y apache2
        fi

        if [ -f "/etc/apache2/ports.conf" ]; then
            cp /etc/apache2/ports.conf /etc/apache2/ports.conf.bak
            retry_command wget -qO /etc/apache2/ports.conf https://raw.githubusercontent.com/gtmylab/mailx/main/apache2/ports.conf
        fi

        a2enmod actions fcgid alias proxy_fcgi ssl headers rewrite proxy proxy_http > /dev/null 2>&1

        mkdir -p /etc/php/8.1/fpm/pool.d /etc/php/8.3/fpm/pool.d /etc/php/8.4/fpm/pool.d /etc/php/5.6/fpm/pool.d

        retry_command wget -qO /etc/php/8.1/fpm/pool.d/www.conf https://raw.githubusercontent.com/gtmylab/mailx/main/php8/www.conf
        retry_command wget -qO /etc/php/8.3/fpm/pool.d/www.conf https://raw.githubusercontent.com/gtmylab/mailx/main/php8/3/www.conf
        retry_command wget -qO /etc/php/8.4/fpm/pool.d/www.conf https://raw.githubusercontent.com/gtmylab/mailx/main/php8/4/www.conf
        retry_command wget -qO /etc/php/5.6/fpm/pool.d/www.conf https://raw.githubusercontent.com/gtmylab/mailx/main/php5/www.conf

        update_php_ini "post_max_size" "50M" "/etc/php/5.6/fpm/php.ini"
        update_php_ini "upload_max_filesize" "50M" "/etc/php/5.6/fpm/php.ini"

        systemctl restart php8.1-fpm php8.3-fpm php8.4-fpm php5.6-fpm 2>/dev/null || true

        mark_stage_complete "apache_installation"
    fi

    # Stage 6: Apache Virtual Hosts
    if ! is_stage_completed "apache_vhosts"; then
        log_info "=== Stage 6: Apache Virtual Hosts Configuration ==="

        mkdir -p /var/www/html/{roundcube,mailx,adminportal,phpmyadmin,.well-known/acme-challenge}
        chown -R www-data:www-data /var/www/html

        # Roundcube on 8080 with SSL (Let's Encrypt when available, self-signed
        # before Stage 8 runs certbot).
        write_roundcube_ssl_vhost "$HOSTNAME"

        cat <<EOF > /etc/apache2/sites-available/adminportal.conf
<VirtualHost *:9090>
    ServerName $HOSTNAME
    DocumentRoot /var/www/html/adminportal
    <Directory /var/www/html/adminportal/>
        Options +FollowSymLinks -Indexes
        AllowOverride All
        Require all granted
        <IfModule mod_dir.c>
            DirectoryIndex index.php
        </IfModule>
    </Directory>
    <FilesMatch \.php\$>
        SetHandler "proxy:unix:/run/php/php8.4-fpm.sock|fcgi://localhost"
    </FilesMatch>
    ErrorLog \${APACHE_LOG_DIR}/adminportal_error.log
    CustomLog \${APACHE_LOG_DIR}/adminportal_access.log combined
</VirtualHost>
EOF

        cat <<EOF > /etc/apache2/sites-available/mailx.conf
<VirtualHost *:8081>
    ServerName $EMAIL_DOMAIN
    DocumentRoot /var/www/html/mailx
    <Directory /var/www/html/mailx/>
        Options +FollowSymlinks
        AllowOverride All
        <IfModule mod_dir.c>
            DirectoryIndex index.php
        </IfModule>
    </Directory>
    <FilesMatch \.php\$>
        SetHandler "proxy:unix:/run/php/php5.6-fpm.sock|fcgi://localhost"
    </FilesMatch>
    ErrorLog \${APACHE_LOG_DIR}/mailx_error.log
    CustomLog \${APACHE_LOG_DIR}/mailx_access.log combined
</VirtualHost>
EOF

        cat <<EOF > /etc/apache2/sites-available/phpmyadmin.conf
<VirtualHost *:8082>
    ServerName $HOSTNAME
    DocumentRoot /var/www/html/phpmyadmin
    <Directory /var/www/html/phpmyadmin/>
        Options +FollowSymlinks
        AllowOverride All
        <IfModule mod_dir.c>
            DirectoryIndex index.php
        </IfModule>
    </Directory>
    <FilesMatch \.php\$>
        SetHandler "proxy:unix:/run/php/php8.4-fpm.sock|fcgi://localhost"
    </FilesMatch>
    ErrorLog \${APACHE_LOG_DIR}/phpmyadmin_error.log
    CustomLog \${APACHE_LOG_DIR}/phpmyadmin_access.log combined
</VirtualHost>
EOF

        a2ensite roundcube.conf adminportal.conf mailx.conf phpmyadmin.conf > /dev/null 2>&1

        mark_stage_complete "apache_vhosts"
    fi

    # Stage 7: PHPMyAdmin Installation
    if ! is_stage_completed "phpmyadmin_installation"; then
        log_info "=== Stage 7: PHPMyAdmin Installation ==="
        setup_phpmyadmin
        mark_stage_complete "phpmyadmin_installation"
    fi

    # Stage 8: SSL Certificate Installation
    if ! is_stage_completed "ssl_installation"; then
        log_info "=== Stage 8: SSL Certificate Installation ==="

        if manage_ssl_certificates install "$HOSTNAME" "$EMAIL_DOMAIN"; then
            mark_stage_complete "ssl_installation"
            # Roundcube's 8080 vhost can now use the Let's Encrypt cert instead
            # of the self-signed placeholder from Stage 6.
            write_roundcube_ssl_vhost "$HOSTNAME"
        else
            log_warning "SSL certificate installation failed. Will retry on next run."
        fi
    fi

    # Stage 9: Roundcube Installation
    if ! is_stage_completed "roundcube_installation"; then
        if execute_stage "roundcube_installation" install_roundcube_application "$EMAIL_DOMAIN" "$HOSTNAME"; then
            log_info "Roundcube installed successfully"
        else
            log_warning "Roundcube installation had issues, attempting verification..."
            verify_roundcube_installation "$EMAIL_DOMAIN"
        fi
    fi

    # Stage 10: Postfix Configuration
    if ! is_stage_completed "postfix_configuration"; then
        log_info "=== Stage 10: Postfix Configuration ==="

        update_postfix_config "$EMAIL_DOMAIN" "$HOSTNAME"
        update_postfix_virtual "$EMAIL_DOMAIN" "admin"
        setup_postfix_header_checks "$HOSTNAME"

        if postfix check 2>/dev/null; then
            log_info "Postfix configuration validated successfully"
        else
            log_warning "Postfix configuration check had warnings"
        fi

        restart_service postfix

        # Re-apply the full Postfix configuration (templates, virtual maps,
        # milter and LMTP settings) so the stage is self-healing.
        repair_postfix_config "$EMAIL_DOMAIN" "$HOSTNAME"

        mark_stage_complete "postfix_configuration"
    fi

    # Stage 11: DKIM Generation and Configuration
    if ! is_stage_completed "dkim_generation"; then
        log_info "=== Stage 11: DKIM Generation and Configuration ==="

        if generate_dkim_key "$EMAIL_DOMAIN"; then
            log_info "DKIM key generated/verified"

            if configure_opendkim "$EMAIL_DOMAIN"; then
                log_info "OpenDKIM service configured successfully"
                verify_dkim "$EMAIL_DOMAIN"
                mark_stage_complete "dkim_generation"
            else
                log_warning "OpenDKIM service configuration had issues"
                mark_stage_complete "dkim_generation"
            fi
        else
            log_error "DKIM key generation failed"
        fi
    fi

    # Stage 12: Additional Files
    if ! is_stage_completed "additional_files"; then
        log_info "=== Stage 12: Additional Files ==="

        mkdir -p /var/www/html/mailx
        retry_command wget -qO /var/www/html/mailx/index.php https://raw.githubusercontent.com/gtmylab/mailx/main/mailer.php
        chown -R www-data:www-data /var/www/html/mailx

        mkdir -p /var/www/html/adminportal
        chown -R www-data:www-data /var/www/html/adminportal

        mark_stage_complete "additional_files"
    fi

    # Stage 13: mailx-admin panel installation
    if ! is_stage_completed "mailx_admin_installation"; then
        if execute_stage "mailx_admin_installation" install_mailx_admin_panel "$EMAIL_DOMAIN" "$HOSTNAME"; then
            log_info "mailx-admin panel installed successfully"
        else
            log_warning "mailx-admin panel installation failed — mail flow is unaffected"
            log_warning "Retry by re-running the installer"
        fi
    fi

    # Stage 14: mailx-admin Apache vhost
    if ! is_stage_completed "mailx_admin_vhost"; then
        if execute_stage "mailx_admin_vhost" install_mailx_admin_vhost "$EMAIL_DOMAIN" "$HOSTNAME"; then
            log_info "mailx-admin vhost configured"
        else
            log_warning "mailx-admin vhost setup failed"
        fi
    fi

    # Final: Restart Services
    log_info "=== Final: Restarting Services ==="
    systemctl restart opendkim 2>/dev/null || true
    sleep 2
    systemctl restart apache2 dovecot postfix 2>/dev/null || true

    # Dry-run reconcile to prove parity
    if [ -x "$ADMIN_BINARY_PATH" ] && [ -f "$ADMIN_CONFIG_FILE" ]; then
        log_info "Running post-install reconcile (dry-run)..."
        "$ADMIN_BINARY_PATH" reconcile --config "$ADMIN_CONFIG_FILE" --dry-run 2>&1 | tee -a "$LOG_FILE" || true
    fi

    # Notification email
    if ! is_stage_completed "notification_sent"; then
        local DKIM_RECORD=""
        if [ -f "/tmp/dkim_txt_record.txt" ]; then
            DKIM_RECORD=$(cat /tmp/dkim_txt_record.txt)
        fi

        send_notification_email "$ADMIN_MAILX_EMAIL" "https://$HOSTNAME:8080" "roundcube" \
            "$(cat /usr/local/roundcube_db_pwd.txt)" \
            "http://$EMAIL_DOMAIN:8081" "$DKIM_RECORD" "default" "http://$HOSTNAME:8082"

        mark_stage_complete "notification_sent"
    fi

    log_info "MailX Installation Completed Successfully!"
    log_info ""
    log_info "Admin panel:      https://admin.$EMAIL_DOMAIN:$ADMIN_WEB_PORT"
    log_info "Initial password: /root/.mailx-admin-initial-password"
}

