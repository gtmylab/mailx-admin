update_php_ini() {
    local setting=$1
    local value=$2
    local ini_file=$3

    if [ -f "$ini_file" ]; then
        if grep -q "^${setting} = " "$ini_file"; then
            sed -i "s/^${setting} = .*/${setting} = ${value}/" "$ini_file"
        else
            echo "${setting} = ${value}" >> "$ini_file"
        fi
    fi
}

configure_dovecot_quota() {
    if [ -f "/etc/dovecot/conf.d/90-quota.conf" ]; then
        log_info "Dovecot quota already configured, skipping..."
        return 0
    fi

    log_info "Configuring Dovecot for quota support..."

    cp /etc/dovecot/dovecot.conf /etc/dovecot/dovecot.conf.bak 2>/dev/null || true
    cp /etc/dovecot/conf.d/10-mail.conf /etc/dovecot/conf.d/10-mail.conf.bak 2>/dev/null || true

    new_mail_location="mbox:~/mail:INBOX=/var/mail/%u"
    escaped_mail_location=$(echo "$new_mail_location" | sed 's/\//\\\//g')
    sed -i "s/^mail_location = .*$/mail_location = $escaped_mail_location/" /etc/dovecot/conf.d/10-mail.conf 2>/dev/null || true

    cat <<EOT > /etc/dovecot/conf.d/90-quota.conf
plugin {
  quota = maildir:User quota
  quota_rule = *:storage=1G
}

protocol imap {
  mail_plugins = \$mail_plugins quota
}

protocol pop3 {
  mail_plugins = \$mail_plugins quota
}
EOT

    log_info "Dovecot quota configuration complete."
}

# ensure_dovecot_managesieve makes the managesieved listener exist and be
# reachable, on a fresh install and on a re-run alike.
#
# Two separate defects left Roundcube's Filters page dead:
#   * `protocols` never contained `sieve`, and Dovecot only starts the daemons
#     of the protocols it is listed under;
#   * the 10-master.conf written below has no managesieve-login block, so
#     nothing listens on 4190 even once the protocol is enabled.
# Both are repaired in place and idempotently, because the rest of this
# function skips on "already configured" -- an existing install would otherwise
# keep the broken pair forever.
ensure_dovecot_managesieve() {
    local conf=/etc/dovecot/dovecot.conf
    local master=/etc/dovecot/conf.d/10-master.conf

    if [ -f "$conf" ]; then
        if ! grep -qE '^protocols[[:space:]]*=' "$conf"; then
            echo "protocols = imap pop3 lmtp sieve" >> "$conf"
            log_info "Enabled the dovecot sieve protocol"
        elif ! grep -qE '^protocols[[:space:]]*=.*[[:space:]]sieve([[:space:]]|$)' "$conf"; then
            sed -i -E 's/^protocols[[:space:]]*=.*/protocols = imap pop3 lmtp sieve/' "$conf"
            log_info "Enabled the dovecot sieve protocol"
        fi
    fi

    if [ -f "$master" ] && ! grep -qE '^[[:space:]]*service[[:space:]]+managesieve-login' "$master"; then
        cat >> "$master" <<'EOF'

service managesieve-login {
  inet_listener sieve {
    port = 4190
    # Loopback only. Roundcube runs on this host, and this install sets
    # disable_plaintext_auth = no, so a world-reachable plaintext port would
    # hand over passwords in the clear.
    address = 127.0.0.1
  }
}
EOF
        log_info "Added the managesieved listener on 127.0.0.1:4190"
    fi
}

configure_dovecot_sasl() {
    if [ -f "/etc/dovecot/conf.d/10-master.conf" ] && [ -S "/var/spool/postfix/private/auth" ]; then
        log_info "Dovecot SASL already configured, skipping..."
        # Not a full skip: managesieved has to be listening here too, or
        # Roundcube's Filters page stays dead on every install made before
        # this check existed.
        ensure_dovecot_managesieve
        return 0
    fi

    log_info "Configuring Dovecot SASL..."

    apt_install dovecot-sieve dovecot-managesieved dovecot-lmtpd sasl2-bin

    if ! id vmail >/dev/null 2>&1; then
        groupadd -g 5000 vmail
        useradd -g vmail -u 5000 vmail -d /var/mail/vmail -m
        chown -R vmail:vmail /var/mail/vmail
    fi

    mkdir -p /var/mail/vhosts
    chown vmail:vmail /var/mail/vhosts
    chmod 0770 /var/mail/vhosts

    mkdir -p /var/spool/postfix/private
    chown -R postfix:postfix /var/spool/postfix/private
    chmod -R 0750 /var/spool/postfix/private

    [ -e /var/spool/postfix/private/auth ] && rm -rf /var/spool/postfix/private/auth

    cat <<EOF > /etc/dovecot/conf.d/10-master.conf
service auth {
  unix_listener /var/spool/postfix/private/auth {
    mode = 0660
    user = postfix
    group = postfix
  }
}

service imap-login {
  inet_listener imap {
    port = 143
  }
  inet_listener imaps {
    port = 993
    ssl = yes
  }
}

service pop3-login {
  inet_listener pop3 {
    port = 110
  }
  inet_listener pop3s {
    port = 995
    ssl = yes
  }
}

service lmtp {
  unix_listener /var/spool/postfix/private/dovecot-lmtp {
    mode = 0600
    user = postfix
    group = postfix
  }
}

service auth-worker {
  user = root
}
EOF

    cat <<EOF > /etc/dovecot/conf.d/10-auth.conf
disable_plaintext_auth = no
auth_mechanisms = plain login
!include auth-system.conf.ext
EOF

    cat <<EOF > /etc/dovecot/conf.d/10-mail.conf
mail_location = maildir:~/Maildir

namespace inbox {
  inbox = yes
  mailbox Drafts {
    auto = subscribe
    special_use = \\Drafts
  }
  mailbox Junk {
    auto = subscribe
    special_use = \\Junk
  }
  mailbox Sent {
    auto = subscribe
    special_use = \\Sent
  }
  mailbox Trash {
    auto = subscribe
    special_use = \\Trash
  }
}
EOF

    cat > /etc/dovecot/conf.d/90-sieve.conf <<'EOF'
# Managed by mailx-admin — DO NOT EDIT
# Per-user scripts: <home>/sieve/managesieve.sieve

plugin {
  sieve = file:~/sieve/managesieve.sieve
  sieve_default = file:~/sieve/managesieve.sieve
  sieve_dir = ~/sieve
}
EOF

    ensure_dovecot_managesieve

    if ! dovecot -n 2>/dev/null; then
        log_warning "Dovecot configuration validation failed, but continuing..."
    fi

    systemctl stop dovecot 2>/dev/null || true
    sleep 2
    systemctl start dovecot || {
        log_error "Dovecot failed to start. Check logs: journalctl -u dovecot -n 20"
        return 1
    }

    if [ -S /var/spool/postfix/private/auth ]; then
        log_info "Dovecot SASL configured successfully"
    else
        log_warning "SASL socket not created immediately, may need manual check"
    fi

    systemctl restart postfix 2>/dev/null || true
}

verify_postfix_dovecot_connection() {
    log_info "Verifying Postfix-Dovecot SASL connection..."
    if ls /var/spool/postfix/private/auth >/dev/null 2>&1; then
        log_info "Postfix can access Dovecot auth socket - configuration OK"
        return 0
    else
        log_warning "Postfix cannot access Dovecot auth socket"
        return 1
    fi
}

test_sasl_authentication() {
    local mode="${1:-strict}"

    log_info "Testing SASL authentication..."

    local caps="" attempt
    for attempt in 1 2 3; do
        caps=$(timeout 5 bash -c 'exec 3<>/dev/tcp/127.0.0.1/587 && printf "EHLO localhost\r\nQUIT\r\n" >&3 && cat <&3' 2>/dev/null || true)

        if echo "$caps" | grep -qiE '^250[- ]AUTH.*PLAIN'; then
            break
        fi
        sleep 2
    done

    if [ -z "$caps" ]; then
        if [ "$mode" = "soft" ]; then
            log_info "Submission port 587 is not listening yet — SASL is verified after the Postfix stage"
        else
            log_warning "No SMTP greeting on 127.0.0.1:587 — SASL could not be verified"
            log_warning "Check: ss -ltnp | grep 587 ; journalctl -u postfix -n 40"
        fi
        return 0
    fi

    if echo "$caps" | grep -qiE '^250[- ]AUTH.*PLAIN'; then
        log_info "SASL PLAIN authentication available"
    else
        log_warning "SASL PLAIN authentication NOT available"
    fi

    if echo "$caps" | grep -qiE '^250[- ]AUTH.*LOGIN'; then
        log_info "SASL LOGIN authentication available"
    else
        log_warning "SASL LOGIN authentication NOT available"
    fi
}

update_postfix_config() {
    local domain="$1"
    local hostname="$2"
    local config_dir="/etc/postfix"
    local backup_dir="${config_dir}/backups"
    local timestamp=$(date +%Y%m%d_%H%M%S)

    if [ -f "$config_dir/main.cf" ] && grep -q "$domain" "$config_dir/main.cf" 2>/dev/null; then
        log_info "Postfix already configured for domain $domain, skipping..."
        return 0
    fi

    log_info "Updating Postfix configuration for domain: $domain, hostname: $hostname"

    mkdir -p "$backup_dir"

    for file in main.cf master.cf; do
        if [[ -f "${config_dir}/${file}" ]]; then
            cp -p "${config_dir}/${file}" "${backup_dir}/${file}.bak_${timestamp}" 2>/dev/null || true
        fi
    done

    declare -A config_urls=(
        ["main.cf"]="https://raw.githubusercontent.com/gtmylab/mailx/main/postfix_main.cf"
        ["master.cf"]="https://raw.githubusercontent.com/gtmylab/mailx/main/postfix_master.cf"
    )

    for file in "${!config_urls[@]}"; do
        url="${config_urls[$file]}"
        log_info "Downloading $file from $url"

        if retry_command "wget -q --timeout=30 --tries=3 -O ${config_dir}/${file}.tmp $url"; then
            if [[ -s "${config_dir}/${file}.tmp" ]]; then
                mv "${config_dir}/${file}.tmp" "${config_dir}/${file}"
                log_info "Successfully downloaded $file"
            else
                log_error "Downloaded file is empty: $file"
                return 1
            fi
        else
            log_error "Failed to download $file"
            return 1
        fi
    done

    for file in main.cf master.cf; do
        if [[ -f "${config_dir}/${file}" ]]; then
            sed -i.bak "s/{EMAIL_DOMAIN}/$domain/g; s/{HOSTNAME}/$hostname/g" "${config_dir}/${file}" 2>/dev/null || true
        fi
    done

    if [[ ! -f "$config_dir/helo_access" ]]; then
        echo "$hostname OK" > "$config_dir/helo_access"
        echo ".$domain OK" >> "$config_dir/helo_access"
        postmap "$config_dir/helo_access" 2>/dev/null || true
    fi

    if [[ ! -f "$config_dir/virtual_domains" ]]; then
        echo "$domain OK" > "$config_dir/virtual_domains"
        postmap "$config_dir/virtual_domains" 2>/dev/null || true
    fi

    postconf -e "virtual_transport = lmtp:unix:private/dovecot-lmtp"

    if postfix check 2>/dev/null; then
        log_info "Postfix configuration validated"
    else
        log_warning "Postfix configuration check had warnings"
    fi

    restart_service postfix
    return 0
}

update_postfix_virtual() {
    local domain=$1
    local username=$2
    register_mailbox_in_panel "${username}@${domain}" 1024 || true
}

setup_postfix_header_checks() {
    local hostname=$1

    log_info "Configuring Postfix header checks..."

    cat <<EOF > /etc/postfix/header_checks
/^Received: from \S+ \(.*\[.*\]\)/ REPLACE Received: from $hostname (localhost [127.0.0.1])
/^X-Originating-IP:/ IGNORE
EOF

    chmod 644 /etc/postfix/header_checks
    postconf -e "header_checks = regexp:/etc/postfix/header_checks"

    log_info "Postfix header checks configured successfully."
}

# ============================================================================
# PHPMyAdmin Installation
# ============================================================================

# configure_postfwd installs the policy daemon the panel's per-domain outgoing
# rate limits are enforced by.
#
# The panel writes /etc/postfwd.cf and points Postfix at it through
# smtpd_end_of_data_restrictions (see RenderPostfixMainCF); this function
# provides the daemon, the account it runs as and a unit that reloads instead of
# restarting. There is no limit by default: an install that never sets one still
# gets a postfwd that answers DUNNO to everything, which costs a policy lookup
# per message and changes no behaviour.
#
# Two flags matter:
#   --keep_rates  keeps the counters across a reload. The panel reloads postfwd
#                 whenever the config changes, and without this every rate
#                 limit would silently reset at that moment.
#   --interface/--port keep it on the loopback address, where Postfix expects it
#                 (smtpd_end_of_data_restrictions in main.cf) and where nobody
#                 else can talk to it.
configure_postfwd() {
    log_info "Configuring postfwd (outgoing rate limits)..."

    apt_install postfwd

    if ! command_exists postfwd; then
        log_warning "postfwd is not available; outgoing rate limits will not be enforced"
        return 0
    fi

    if ! getent group postfw >/dev/null 2>&1; then
        groupadd -r postfw 2>/dev/null || true
    fi
    if ! id postfw >/dev/null 2>&1; then
        useradd -r -g postfw -d /var/lib/postfwd -s /usr/sbin/nologin postfw 2>/dev/null || true
    fi
    install -d -o postfw -g postfw -m 0750 /var/lib/postfwd 2>/dev/null || true

    # The panel replaces this file on the first sync that has a limit to render.
    # Until then it has to exist and be valid, or postfwd refuses to start.
    if [ ! -f /etc/postfwd.cf ]; then
        cat > /etc/postfwd.cf <<'EOF'
# Managed by mailx-admin -- replaced on the first sync that has a rate limit.
id=DEFAULT; action=dunno
EOF
        chmod 0644 /etc/postfwd.cf
    fi

    cat > /etc/systemd/system/postfwd.service <<'EOF'
[Unit]
Description=postfwd - Postfix policy daemon (outgoing rate limits)
After=network.target postfix.service
Wants=postfix.service

[Service]
# postfwd forks itself into the background, which is what Type=forking tracks.
Type=forking
ExecStart=/usr/sbin/postfwd --file /etc/postfwd.cf --user postfw --group postfw --interface 127.0.0.1 --port 10040 --keep_rates
# The panel reloads postfwd after writing the config; SIGHUP re-reads the rules
# and keeps the counters (--keep_rates).
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload

    systemctl enable postfwd >/dev/null 2>&1 || true
    systemctl restart postfwd >/dev/null 2>&1 || true

    sleep 1
    if systemctl is-active --quiet postfwd; then
        log_info "postfwd listening on 127.0.0.1:10040"
    else
        log_warning "postfwd did not start; check: journalctl -u postfwd -n 30"
    fi
}

# setup_phpmyadmin installs (or verifies) phpMyAdmin.
setup_phpmyadmin() {
    if [ -d "/var/www/html/phpmyadmin" ] && [ -f "/var/www/html/phpmyadmin/config.inc.php" ]; then
        log_info "PHPMyAdmin already installed, skipping..."
        return 0
    fi

    log_info "Installing phpMyAdmin..."

    PMA_VERSION="5.1.1"
    PMA_DIR="/var/www/html/phpmyadmin"
    PMA_URL="https://files.phpmyadmin.net/phpMyAdmin/${PMA_VERSION}/phpMyAdmin-${PMA_VERSION}-all-languages.tar.gz"
    PMA_TAR="phpMyAdmin-${PMA_VERSION}-all-languages.tar.gz"
    PMA_TAR_DIR="phpMyAdmin-${PMA_VERSION}-all-languages"

    local CURRENT_DIR=$(pwd)
    cd /tmp || {
        log_error "Failed to change to /tmp directory"
        return 1
    }

    rm -rf "$PMA_TAR_DIR" "$PMA_TAR" 2>/dev/null || true

    log_info "Downloading phpMyAdmin version $PMA_VERSION..."
    local download_success=false

    for i in {1..3}; do
        if wget -q --timeout=30 --tries=3 "$PMA_URL" -O "$PMA_TAR" 2>/dev/null; then
            if [ -s "$PMA_TAR" ]; then
                download_success=true
                break
            fi
        fi
        log_warning "Download attempt $i failed, retrying..."
        sleep 5
    done

    if [ "$download_success" != "true" ]; then
        log_error "Failed to download phpMyAdmin after multiple attempts"
        cd "$CURRENT_DIR" 2>/dev/null || true
        return 1
    fi

    log_info "Extracting phpMyAdmin..."
    if ! tar -xzf "$PMA_TAR" 2>/dev/null; then
        log_error "Failed to extract phpMyAdmin"
        rm -f "$PMA_TAR" 2>/dev/null || true
        cd "$CURRENT_DIR" 2>/dev/null || true
        return 1
    fi

    if [ ! -d "$PMA_TAR_DIR" ]; then
        log_error "Extraction failed - directory not found"
        rm -f "$PMA_TAR" 2>/dev/null || true
        cd "$CURRENT_DIR" 2>/dev/null || true
        return 1
    fi

    if [ -d "$PMA_DIR" ]; then
        log_info "Removing existing phpMyAdmin directory..."
        rm -rf "$PMA_DIR"
    fi

    mv "$PMA_TAR_DIR" "$PMA_DIR"
    rm -f "$PMA_TAR"

    SECRET=$(generate_blowfish_secret)

    if [ -f "$PMA_DIR/config.sample.inc.php" ]; then
        cp "$PMA_DIR/config.sample.inc.php" "$PMA_DIR/config.inc.php"
        sed -i "s|\(\$cfg\['blowfish_secret'\]\).*|\1 = '$SECRET';|" "$PMA_DIR/config.inc.php"
    else
        log_warning "Config sample not found, creating default config..."
        cat > "$PMA_DIR/config.inc.php" <<EOF
<?php
\$cfg['blowfish_secret'] = '$SECRET';
\$i = 0;
\$i++;
\$cfg['Servers'][\$i]['auth_type'] = 'cookie';
\$cfg['Servers'][\$i]['host'] = 'localhost';
\$cfg['Servers'][\$i]['compress'] = false;
\$cfg['Servers'][\$i]['AllowNoPassword'] = false;
?>
EOF
    fi

    chown -R www-data:www-data "$PMA_DIR"
    chmod -R 755 "$PMA_DIR"
    find "$PMA_DIR" -type f -exec chmod 644 {} \;

    cd "$CURRENT_DIR" 2>/dev/null || true

    if [ -f "$PMA_DIR/config.inc.php" ]; then
        log_info "PHPMyAdmin installation completed successfully"
        return 0
    else
        log_error "PHPMyAdmin installation verification failed"
        return 1
    fi
}

# ============================================================================
# Stage Execution Helper
# ============================================================================

execute_stage() {
    local stage_name=$1
    local stage_function=$2
    shift 2

    if is_stage_completed "$stage_name"; then
        log_info "Stage '$stage_name' already completed, skipping..."
        return 0
    fi

    log_info "=== Stage: $stage_name ==="

    set +e
    $stage_function "$@"
    local exit_code=$?
    set -e

    if [ $exit_code -eq 0 ]; then
        mark_stage_complete "$stage_name"
        log_info "Stage '$stage_name' completed successfully"
        return 0
    else
        log_error "Stage '$stage_name' failed with exit code $exit_code"
        return 1
    fi
}

# ============================================================================
# State Cleanup
# ============================================================================

cleanup_state() {
    local stage=$1

    if [ -z "$stage" ]; then
        read -p "Are you sure you want to remove all state files? (y/n): " confirm
        if [[ "$confirm" == "y" ]]; then
            rm -f "$STATE_DIR"/*.completed
            log_info "All state files removed"
        fi
    else
        if [ "$stage" == "phpmyadmin_installation" ]; then
            if [ -d "/var/www/html/phpmyadmin" ] && [ ! -f "/var/www/html/phpmyadmin/config.inc.php" ]; then
                log_info "Removing incomplete phpMyAdmin installation..."
                rm -rf "/var/www/html/phpmyadmin"
            fi
        fi

        if [ "$stage" == "mailx_admin_installation" ]; then
            log_info "Stopping mailx-admin service..."
            systemctl stop mailx-admin 2>/dev/null || true
        fi

        rm -f "$STATE_DIR/${stage}.completed"
        log_info "State for stage '$stage' removed"
    fi
}

# ============================================================================
# DKIM Functions
# ============================================================================

extract_dkim_record() {
    local txt_file=$1

    if [ ! -f "$txt_file" ]; then
        echo ""
        return 1
    fi

    local result
    result=$(grep -o '"[^"]*"' "$txt_file" 2>/dev/null | sed 's/"//g' | tr -d '\n\t' | sed 's/  */ /g; s/^ //; s/ $//')

    if [ -z "$result" ]; then
        result=$(awk -F'"' '{for(i=2;i<=NF;i+=2) printf "%s",$i}' "$txt_file" 2>/dev/null | sed 's/  */ /g; s/^ //; s/ $//')
    fi

    echo "$result"
}

generate_dkim_key() {
    local DOMAIN=$1
    local SELECTOR="default"
    local DKIM_BASE="/etc/opendkim"
    local KEY_DIR="$DKIM_BASE/keys/$DOMAIN"
    local KEY_FILE="$KEY_DIR/$SELECTOR.private"
    local TXT_FILE="$KEY_DIR/$SELECTOR.txt"

    if ! command -v opendkim-genkey &> /dev/null; then
        log_info "Installing OpenDKIM packages..."
        apt_install opendkim opendkim-tools
    fi

    if ! id opendkim &>/dev/null; then
        groupadd -r opendkim 2>/dev/null || true
        useradd -r -g opendkim -s /usr/sbin/nologin opendkim 2>/dev/null || true
    fi

    if [ -f "$KEY_FILE" ]; then
        log_info "DKIM key already exists for domain $DOMAIN"

        if [ -f "$TXT_FILE" ]; then
            local DKIM_RECORD
            DKIM_RECORD=$(extract_dkim_record "$TXT_FILE")
            if [ -n "$DKIM_RECORD" ]; then
                echo "$DKIM_RECORD" > /tmp/dkim_txt_record.txt
                echo "$DKIM_RECORD" > /usr/local/mailx_dkim_record.txt
                log_info "DKIM TXT record extracted: $SELECTOR._domainkey.$DOMAIN"
            fi
        fi

        chown opendkim:opendkim "$KEY_FILE" 2>/dev/null || true
        chmod 600 "$KEY_FILE" 2>/dev/null || true
        return 0
    fi

    log_info "Generating DKIM key for domain $DOMAIN..."

    mkdir -p "$KEY_DIR"
    chown -R opendkim:opendkim "$DKIM_BASE" 2>/dev/null || true
    chmod 750 "$DKIM_BASE"
    chmod 750 "$DKIM_BASE/keys"
    chmod 750 "$KEY_DIR"

    local CURRENT_DIR=$(pwd)
    cd "$KEY_DIR" || {
        log_error "Failed to change to key directory: $KEY_DIR"
        return 1
    }

    if ! opendkim-genkey -s "$SELECTOR" -d "$DOMAIN" -b 2048; then
        log_error "Failed to generate DKIM key"
        cd "$CURRENT_DIR" 2>/dev/null || true
        return 1
    fi

    chmod 600 "$SELECTOR.private"
    chmod 644 "$SELECTOR.txt"
    chown opendkim:opendkim "$SELECTOR.private" "$SELECTOR.txt"

    local DKIM_RECORD
    DKIM_RECORD=$(extract_dkim_record "$SELECTOR.txt")

    if [ -n "$DKIM_RECORD" ]; then
        echo "$DKIM_RECORD" > /tmp/dkim_txt_record.txt
        echo "$DKIM_RECORD" > /usr/local/mailx_dkim_record.txt
        log_info "DKIM key generated successfully"
        log_info "DKIM TXT record: $SELECTOR._domainkey.$DOMAIN = \"$DKIM_RECORD\""
    else
        log_error "Failed to extract DKIM TXT record from generated file"
        cd "$CURRENT_DIR" 2>/dev/null || true
        return 1
    fi

    cd "$CURRENT_DIR" 2>/dev/null || true
    return 0
}

configure_opendkim() {
    local DOMAIN=$1
    local SELECTOR="default"
    local OPENDKIM_CONF="/etc/opendkim.conf"
    local OPENDKIM_DIR="/etc/opendkim"
    local SOCKET_DIR="/var/spool/postfix/opendkim"

    log_info "Configuring OpenDKIM for domain $DOMAIN..."

    systemctl stop opendkim 2>/dev/null || true
    pkill -f opendkim 2>/dev/null || true
    sleep 1

    mkdir -p "$SOCKET_DIR"
    mkdir -p /var/run/opendkim
    chown opendkim:postfix "$SOCKET_DIR"
    chmod 775 "$SOCKET_DIR"
    chown opendkim:opendkim /var/run/opendkim
    chmod 755 /var/run/opendkim
    chmod g+s "$SOCKET_DIR"

    rm -f "$SOCKET_DIR/opendkim.sock" 2>/dev/null || true

    mkdir -p "$OPENDKIM_DIR/keys/$DOMAIN"

    chown -R opendkim:opendkim "$OPENDKIM_DIR" 2>/dev/null || true
    chmod 750 "$OPENDKIM_DIR"
    chmod 750 "$OPENDKIM_DIR/keys"
    chmod 750 "$OPENDKIM_DIR/keys/$DOMAIN"

    if [ -f "$OPENDKIM_DIR/keys/$DOMAIN/$SELECTOR.private" ]; then
        chmod 600 "$OPENDKIM_DIR/keys/$DOMAIN/$SELECTOR.private"
        chown opendkim:opendkim "$OPENDKIM_DIR/keys/$DOMAIN/$SELECTOR.private"
    else
        log_error "DKIM private key not found: $OPENDKIM_DIR/keys/$DOMAIN/$SELECTOR.private"
        return 1
    fi

    cat > "$OPENDKIM_CONF" <<EOF
Syslog                  yes
SyslogSuccess           yes
LogWhy                  yes

Canonicalization        relaxed/simple
Mode                    sv
SubDomains              no
OversignHeaders         From
SignatureAlgorithm      rsa-sha256
UMask                   007

UserID                  opendkim:opendkim

Socket                  local:$SOCKET_DIR/opendkim.sock

Domain                  $DOMAIN
Selector                $SELECTOR
KeyFile                 $OPENDKIM_DIR/keys/$DOMAIN/$SELECTOR.private

AutoRestart             yes
AutoRestartRate         10/1M
DNSTimeout              5
EOF

    cat > "$OPENDKIM_DIR/KeyTable" <<EOF
$SELECTOR._domainkey.$DOMAIN $DOMAIN:$SELECTOR:$OPENDKIM_DIR/keys/$DOMAIN/$SELECTOR.private
EOF

    cat > "$OPENDKIM_DIR/SigningTable" <<EOF
*@$DOMAIN $SELECTOR._domainkey.$DOMAIN
EOF

    cat > "$OPENDKIM_DIR/TrustedHosts" <<EOF
127.0.0.1
::1
localhost
$DOMAIN
$(mail_host)
EOF

    chmod 644 "$OPENDKIM_CONF"
    chmod 644 "$OPENDKIM_DIR/KeyTable"
    chmod 644 "$OPENDKIM_DIR/SigningTable"
    chmod 644 "$OPENDKIM_DIR/TrustedHosts"

    cat > /etc/systemd/system/opendkim.service <<'EOF'
[Unit]
Description=OpenDKIM DomainKeys Identified Mail Milter
After=network.target

[Service]
Type=simple
User=opendkim
Group=opendkim
ExecStart=/usr/sbin/opendkim -x /etc/opendkim.conf -f
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload

    log_info "Starting OpenDKIM service..."
    systemctl start opendkim

    sleep 3

    if systemctl is-active --quiet opendkim; then
        log_info "OpenDKIM started successfully"

        if [ -S "$SOCKET_DIR/opendkim.sock" ]; then
            log_info "OpenDKIM socket created: $SOCKET_DIR/opendkim.sock"
            chmod 660 "$SOCKET_DIR/opendkim.sock"
            chown opendkim:postfix "$SOCKET_DIR/opendkim.sock"
        else
            log_warning "OpenDKIM socket not found, restarting service..."
            systemctl restart opendkim
            sleep 2
            if [ -S "$SOCKET_DIR/opendkim.sock" ]; then
                chmod 660 "$SOCKET_DIR/opendkim.sock"
                chown opendkim:postfix "$SOCKET_DIR/opendkim.sock"
            fi
        fi

        systemctl enable opendkim 2>/dev/null || true

        log_info "Configuring Postfix for DKIM signing..."
        postconf -e "milter_default_action = accept"
        postconf -e "milter_protocol = 2"
        postconf -e "smtpd_milters = unix:opendkim/opendkim.sock"
        postconf -e "non_smtpd_milters = unix:opendkim/opendkim.sock"

        systemctl restart postfix

        log_info "Postfix configured for DKIM signing"
        return 0
    else
        log_error "OpenDKIM failed to start"
        journalctl -u opendkim -n 20 --no-pager 2>/dev/null || true
        return 1
    fi
}

verify_dkim() {
    local DOMAIN=$1
    local SELECTOR="default"

    log_info "Verifying DKIM configuration..."

    if ! systemctl is-active --quiet opendkim; then
        log_warning "OpenDKIM is not running"
        return 1
    fi
    log_info "OpenDKIM service is running"

    if [ -S "/var/spool/postfix/opendkim/opendkim.sock" ]; then
        local SOCKET_PERMS
        SOCKET_PERMS=$(stat -c "%a %U:%G" /var/spool/postfix/opendkim/opendkim.sock 2>/dev/null || echo "unknown")
        log_info "Socket permissions: $SOCKET_PERMS"
    else
        log_warning "OpenDKIM socket not found"
        return 1
    fi

    log_info "Testing DKIM key (may fail if DNS not propagated)..."
    if opendkim-testkey -d "$DOMAIN" -s "$SELECTOR" 2>&1 | grep -q "key OK"; then
        log_info "DKIM key verification successful"
    else
        log_warning "DKIM key test failed (DNS may not be configured yet)"
        log_info "After adding the DNS record, verify with: opendkim-testkey -d $DOMAIN -s $SELECTOR -vvv"
    fi

    if [ -f "/tmp/dkim_txt_record.txt" ]; then
        log_info "Required DNS TXT record:"
        log_info "  Host: $SELECTOR._domainkey.$DOMAIN"
        log_info "  Value: \"$(cat /tmp/dkim_txt_record.txt)\""
    fi

    return 0
}

# ============================================================================
# SSL Certificate Functions
# ============================================================================

configure_ssl_services() {
    local domain=$1
    local cert_path="/etc/letsencrypt/live/$domain"

    if [ ! -d "$cert_path" ]; then
        log_warning "SSL certificate not found for $domain, skipping service configuration"
        return 1
    fi

    if [ -f "/etc/apache2/sites-available/adminportal.conf" ]; then
        sed -i "s|SSLCertificateFile.*|SSLCertificateFile $cert_path/fullchain.pem|" /etc/apache2/sites-available/adminportal.conf 2>/dev/null || true
        sed -i "s|SSLCertificateKeyFile.*|SSLCertificateKeyFile $cert_path/privkey.pem|" /etc/apache2/sites-available/adminportal.conf 2>/dev/null || true
    fi

    postconf -e "smtpd_tls_cert_file=$cert_path/fullchain.pem" 2>/dev/null || true
    postconf -e "smtpd_tls_key_file=$cert_path/privkey.pem" 2>/dev/null || true

    if [ -f "/etc/dovecot/conf.d/10-ssl.conf" ]; then
        sed -i "s|ssl_cert =.*|ssl_cert = <$cert_path/fullchain.pem|" /etc/dovecot/conf.d/10-ssl.conf 2>/dev/null || true
        sed -i "s|ssl_key =.*|ssl_key = <$cert_path/privkey.pem|" /etc/dovecot/conf.d/10-ssl.conf 2>/dev/null || true
    fi

    log_info "SSL services configured for domain $domain"
}

setup_ssl_renewal() {
    if [ -f "/usr/local/bin/ssl_renewal.sh" ]; then
        log_info "SSL renewal already configured, skipping..."
        return 0
    fi

    cat << 'EOF' > /usr/local/bin/ssl_renewal.sh
#!/bin/bash
certbot renew --quiet --post-hook "systemctl reload postfix dovecot apache2"
EOF

    chmod +x /usr/local/bin/ssl_renewal.sh
    (crontab -l 2>/dev/null | grep -v "ssl_renewal.sh"; echo "0 3 * * * /usr/local/bin/ssl_renewal.sh") | crontab - 2>/dev/null || true

    log_info "Automatic SSL renewal configured."
}

# ============================================================================
# SSL Certificate Management — View, Renew, Notify
# ============================================================================

get_ssl_domain() {
    local domain
    domain=$(cat /usr/local/roundcube_mail_domain.txt 2>/dev/null | tr -d '[:space:]')
    if [ -z "$domain" ]; then
        domain=$(certbot certificates 2>/dev/null \
            | awk -F': ' '/Certificate Name/ {print $2; exit}' \
            | tr -d '[:space:]')
    fi
    echo "$domain"
}

mail_host() {
    local mh
    mh=$(cat /usr/local/roundcube_mail_hostname.txt 2>/dev/null | tr -d '[:space:]')
    if [ -z "$mh" ]; then
        mh=$(cat /etc/mailname 2>/dev/null | tr -d '[:space:]')
        mh="${mh:-$(hostname -f 2>/dev/null || hostname)}"
    fi
    printf '%s' "$mh"
}

cert_domains() {
    local hostname=$1 email_domain=$2 mail_hostname=${3:-} include_admin=${4:-1}
    local out="$hostname"
    if [ "$include_admin" = "1" ]; then
        case " $out " in *" admin.$email_domain "*) ;; *) out="$out admin.$email_domain" ;; esac
    fi
    case " $out " in *" $email_domain "*) ;; *) out="$out $email_domain" ;; esac
    if [ -n "$mail_hostname" ]; then
        case " $out " in *" $mail_hostname "*) ;; *) out="$out $mail_hostname" ;; esac
    fi

    local args=""
    for d in $out; do
        args="${args}${args:+ }-d ${d}"
    done
    printf '%s' "$args"
}

show_ssl_details() {
    echo ""
    echo "=============================================="
    echo "   SSL Certificate Details"
    echo "=============================================="
    echo ""

    if ! command -v certbot &>/dev/null; then
        log_error "certbot is not installed. SSL is not configured on this server."
        return 1
    fi

    local primary_domain
    primary_domain=$(get_ssl_domain)

    if [ -z "$primary_domain" ]; then
        log_warning "No primary domain recorded and no certbot certs found."
        log_info "Listing all certbot certificates:"
        certbot certificates 2>/dev/null || echo "  (none)"
        return 1
    fi

    local cert_path="/etc/letsencrypt/live/$primary_domain"
    if [ ! -d "$cert_path" ]; then
        log_error "Certificate directory not found: $cert_path"
        log_info "Listing available certbot certificates:"
        certbot certificates 2>/dev/null || echo "  (none)"
        return 1
    fi

    local fullchain="$cert_path/fullchain.pem"
    if [ ! -f "$fullchain" ]; then
        log_error "fullchain.pem not found at $fullchain"
        return 1
    fi

    local subject issuer not_before not_after serial sigalg
    subject=$(openssl x509 -in "$fullchain" -noout -subject 2>/dev/null | sed 's/^subject=//')
    issuer=$(openssl x509 -in "$fullchain" -noout -issuer  2>/dev/null | sed 's/^issuer=//')
    not_before=$(openssl x509 -in "$fullchain" -noout -startdate 2>/dev/null | cut -d= -f2)
    not_after=$(openssl x509 -in "$fullchain" -noout -enddate   2>/dev/null | cut -d= -f2)
    serial=$(openssl x509 -in "$fullchain" -noout -serial 2>/dev/null | cut -d= -f2)
    sigalg=$(openssl x509 -in "$fullchain" -noout -text 2>/dev/null \
        | awk -F': ' '/Signature Algorithm/ {print $2; exit}')

    local not_after_epoch now_epoch days_left hours_left human_left
    not_after_epoch=$(date -d "$not_after" +%s 2>/dev/null)
    now_epoch=$(date +%s)
    days_left=$(( (not_after_epoch - now_epoch) / 86400 ))
    hours_left=$(( ((not_after_epoch - now_epoch) % 86400) / 3600 ))

    if [ "$days_left" -lt 0 ]; then
        human_left="EXPIRED $(( -days_left )) days ago"
    elif [ "$days_left" -eq 0 ]; then
        human_left="$hours_left hours"
    else
        human_left="$days_left days, $hours_left hours"
    fi

    local sans
    sans=$(openssl x509 -in "$fullchain" -noout -text 2>/dev/null \
        | awk '/X509v3 Subject Alternative Name/ {getline; gsub(/^[ \t]+/, ""); print; exit}')

    local key_bits key_type
    key_bits=$(openssl x509 -in "$fullchain" -noout -text 2>/dev/null \
        | awk -F'[()]' '/Public-Key:/ {print $2; exit}')
    key_type=$(openssl x509 -in "$fullchain" -noout -text 2>/dev/null \
        | awk '/Public Key Algorithm/ {print $3; exit}')

    local chain_count
    chain_count=$(grep -c "BEGIN CERTIFICATE" "$fullchain" 2>/dev/null)

    echo "Primary domain : $primary_domain"
    echo "Cert directory : $cert_path"
    echo ""
    echo "Subject        : $subject"
    echo "Issuer         : $issuer"
    echo "Serial         : $serial"
    echo "Signature alg  : $sigalg"
    echo "Public key     : $key_type ${key_bits}"
    echo "Chain length   : $chain_count certificate(s)"
    echo ""
    echo "Valid from     : $not_before"
    echo "Valid until    : $not_after"
    echo "Expires in     : $human_left"
    echo ""
    echo "SANs           :"
    if [ -n "$sans" ]; then
        echo "$sans" | tr ',' '\n' | sed 's/^[ \t]*/  - /'
    else
        echo "  (none)"
    fi
    echo ""

    if [ "$days_left" -lt 0 ]; then
        echo -e "${RED}STATUS: EXPIRED${NC}"
    elif [ "$days_left" -le 7 ]; then
        echo -e "${RED}STATUS: CRITICAL — expires in $days_left day(s)${NC}"
    elif [ "$days_left" -le 21 ]; then
        echo -e "${YELLOW}STATUS: WARNING — expires in $days_left day(s)${NC}"
    else
        echo -e "${GREEN}STATUS: OK${NC}"
    fi
    echo ""

    if [ -f "/etc/letsencrypt/renewal/$primary_domain.conf" ]; then
        echo "Renewal configuration:"
        grep -E '^(authenticator|installer|webroot_path|archive_dir|server)\s*=' \
            "/etc/letsencrypt/renewal/$primary_domain.conf" 2>/dev/null \
            | sed 's/^/  /' || true
        echo ""
    fi

    echo "Auto-renewal mechanisms:"
    if systemctl is-enabled certbot.timer >/dev/null 2>&1; then
        local next_run
        next_run=$(systemctl list-timers certbot.timer --no-pager 2>/dev/null \
            | awk 'NR==2 {print $1" "$2" "$3}')
        echo "  ✓ certbot.timer enabled (next: ${next_run:-unknown})"
    else
        echo "  ✗ certbot.timer NOT enabled"
    fi

    if crontab -l 2>/dev/null | grep -q "ssl_renewal.sh"; then
        echo "  ✓ Cron entry for ssl_renewal.sh present"
    else
        echo "  ✗ No cron entry for ssl_renewal.sh"
    fi

    if [ -x "/usr/local/bin/ssl_renewal.sh" ]; then
        echo "  ✓ /usr/local/bin/ssl_renewal.sh exists"
    else
        echo "  ✗ /usr/local/bin/ssl_renewal.sh missing"
    fi
    echo ""

    echo "All certificates on this server:"
    certbot certificates 2>/dev/null | sed 's/^/  /' || echo "  (none)"
    echo ""
}

renew_ssl_now() {
    echo ""
    echo "=============================================="
    echo "   Renew SSL Certificates Now"
    echo "=============================================="
    echo ""

    if ! command -v certbot &>/dev/null; then
        log_error "certbot is not installed."
        return 1
    fi

    local primary_domain
    primary_domain=$(get_ssl_domain)

    if [ -z "$primary_domain" ]; then
        log_error "No domain configured. Run the installer first."
        return 1
    fi

    echo "Primary domain : $primary_domain"
    echo ""
    echo "Choose renewal mode:"
    echo "  1) Normal renew (only if < 30 days left)"
    echo "  2) Force renew  (regardless of expiry)"
    echo "  3) Dry run      (test only, no changes)"
    echo "  4) Cancel"
    echo ""
    read -p "Choice (1-4): " mode

    case "$mode" in
        1)
            log_info "Running normal renewal..."
            if certbot renew --quiet --post-hook "systemctl reload postfix dovecot apache2"; then
                log_info "Renewal completed"
            else
                log_error "Renewal failed"
                notify_ssl_failure "Normal renewal failed at $(date)"
                return 1
            fi
            ;;
        2)
            log_info "Forcing renewal for $primary_domain..."
            local hostname mail_hostname
            hostname=$(cat /etc/mailname 2>/dev/null | tr -d '[:space:]')
            hostname="${hostname:-$(hostname -f 2>/dev/null || hostname)}"
            mail_hostname=$(cat /usr/local/roundcube_mail_hostname.txt 2>/dev/null | tr -d '[:space:]')
            if certbot certonly --force-renewal \
                $(cert_domains "$hostname" "$primary_domain" "$mail_hostname") \
                --non-interactive --agree-tos \
                --email "admin@$primary_domain" \
                --post-hook "systemctl reload postfix dovecot apache2"; then
                log_info "Forced renewal completed"
            else
                log_error "Forced renewal failed"
                notify_ssl_failure "Forced renewal failed at $(date)"
                return 1
            fi
            ;;
        3)
            log_info "Running dry-run (no changes will be made)..."
            if certbot renew --dry-run; then
                log_info "Dry run succeeded — actual renewal should work"
            else
                log_error "Dry run failed — investigate before renewing"
                return 1
            fi
            ;;
        4)
            log_info "Cancelled."
            return 0
            ;;
        *)
            log_error "Invalid choice"
            return 1
            ;;
    esac

    echo ""
    log_info "Post-renewal certificate status:"
    show_ssl_details
}

notify_ssl_failure() {
    local reason="$1"
    local admin_email
    admin_email=$(cat /usr/local/mailx_admin_email.txt 2>/dev/null | tr -d '[:space:]')
    local domain
    domain=$(get_ssl_domain)
    local hostname
    hostname=$(hostname)

    local fail_log="/var/log/mailx/ssl_renewal_failures.log"
    mkdir -p "$(dirname "$fail_log")"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $reason" >> "$fail_log"

    if [ -z "$admin_email" ]; then
        log_warning "No admin email configured for SSL notifications (saved to $fail_log)"
        return 0
    fi

    local body="===========================================
SSL RENEWAL FAILURE — ACTION REQUIRED
===========================================

Server    : $hostname
Domain    : ${domain:-unknown}
Time      : $(date '+%Y-%m-%d %H:%M:%S')
Reason    : $reason

WHAT TO DO:
-----------
1. SSH into the server
2. Run: certbot renew --dry-run
3. Check logs: tail -n 50 /var/log/letsencrypt/letsencrypt.log
4. Common causes:
   - Port 80 blocked (HTTP-01 challenge fails)
   - DNS changed / domain no longer points here
   - Rate limit hit
   - Webroot path missing

MANUAL RENEWAL:
---------------
certbot renew --force-renewal
systemctl reload postfix dovecot apache2

Check current cert status:
   Run the MailX script -> option 15 (View SSL Certificate Details)

Failure log: $fail_log
==========================================="

    echo -e "$body" | mail -s "[$hostname] SSL renewal FAILED for ${domain:-unknown}" \
        -a "From: admin@${domain:-localhost}" "$admin_email" 2>/dev/null || \
        log_warning "Failed to send SSL failure email to $admin_email"
}

configure_ssl_autorenewal() {
    echo ""
    echo "=============================================="
    echo "   Configure SSL Auto-Renewal & Notifications"
    echo "=============================================="
    echo ""

    if ! command -v certbot &>/dev/null; then
        log_error "certbot is not installed. Run the installer first."
        return 1
    fi

    local primary_domain
    primary_domain=$(get_ssl_domain)

    local default_admin="admin@${primary_domain:-example.com}"
    local current_admin
    current_admin=$(cat /usr/local/mailx_admin_email.txt 2>/dev/null || echo "")

    echo "Current admin email for notifications: ${current_admin:-<not set>}"
    read -p "Enter admin email for SSL notifications [$default_admin]: " admin_email
    admin_email="${admin_email:-$default_admin}"

    if [[ ! "$admin_email" =~ ^[^@]+@[^@]+\.[^@]+$ ]]; then
        log_error "Invalid email address: $admin_email"
        return 1
    fi

    echo "$admin_email" > /usr/local/mailx_admin_email.txt
    chmod 600 /usr/local/mailx_admin_email.txt
    log_info "Admin email saved: $admin_email"

    local current_days
    current_days=$(cat /usr/local/mailx_ssl_warn_days.txt 2>/dev/null || echo "14")
    echo ""
    echo "Current warning threshold: $current_days days before expiry"
    read -p "Notify when cert has fewer than N days left [14]: " warn_days
    warn_days="${warn_days:-14}"

    if ! [[ "$warn_days" =~ ^[0-9]+$ ]] || [ "$warn_days" -lt 1 ] || [ "$warn_days" -gt 89 ]; then
        log_error "Threshold must be between 1 and 89 days"
        return 1
    fi

    echo "$warn_days" > /usr/local/mailx_ssl_warn_days.txt
    log_info "Warning threshold set to $warn_days days"

    log_info "Creating renewal wrapper: /usr/local/bin/ssl_renewal.sh"

    cat > /usr/local/bin/ssl_renewal.sh <<'RENEWAL_EOF'
#!/bin/bash
ADMIN_EMAIL_FILE="/usr/local/mailx_admin_email.txt"
WARN_DAYS_FILE="/usr/local/mailx_ssl_warn_days.txt"
DOMAIN_FILE="/usr/local/roundcube_mail_domain.txt"
FAIL_LOG="/var/log/mailx/ssl_renewal_failures.log"
STATE_DIR="/usr/local/mailx_state"

mkdir -p "$(dirname "$FAIL_LOG")" "$STATE_DIR"

ADMIN_EMAIL=$(cat "$ADMIN_EMAIL_FILE" 2>/dev/null | tr -d '[:space:]')
WARN_DAYS=$(cat "$WARN_DAYS_FILE" 2>/dev/null | tr -d '[:space:]')
DOMAIN=$(cat "$DOMAIN_FILE" 2>/dev/null | tr -d '[:space:]')
WARN_DAYS=${WARN_DAYS:-14}
HOSTNAME=$(hostname)

log_fail() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$FAIL_LOG"
}

send_mail() {
    local subject="$1"
    local body="$2"
    if [ -n "$ADMIN_EMAIL" ]; then
        echo -e "$body" | mail -s "$subject" \
            -a "From: admin@${DOMAIN:-localhost}" "$ADMIN_EMAIL" 2>/dev/null || true
    fi
}

CERTBOT_LOG=$(mktemp)
if certbot renew --quiet \
        --deploy-hook "systemctl reload postfix dovecot apache2" \
        > "$CERTBOT_LOG" 2>&1; then
    RENEW_RC=0
else
    RENEW_RC=$?
fi

if [ "$RENEW_RC" -ne 0 ]; then
    TODAY=$(date +%Y-%m-%d)
    LAST_ALERT_FILE="$STATE_DIR/ssl_last_fail_alert"
    LAST_ALERT=$(cat "$LAST_ALERT_FILE" 2>/dev/null)
    if [ "$LAST_ALERT" != "$TODAY" ]; then
        echo "$TODAY" > "$LAST_ALERT_FILE"
        log_fail "certbot renew failed (rc=$RENEW_RC)"
        send_mail "[$HOSTNAME] SSL renewal FAILED for ${DOMAIN:-unknown}" \
"SSL RENEWAL FAILURE

Server    : $HOSTNAME
Domain    : ${DOMAIN:-unknown}
Time      : $(date '+%Y-%m-%d %H:%M:%S')

Certbot output (last 30 lines):
$(tail -n 30 "$CERTBOT_LOG")

MANUAL RENEWAL:
   certbot renew --force-renewal
   systemctl reload postfix dovecot apache2"
    fi
    rm -f "$CERTBOT_LOG"
    exit 1
fi
rm -f "$CERTBOT_LOG"

if [ -n "$DOMAIN" ] && [ -f "/etc/letsencrypt/live/$DOMAIN/fullchain.pem" ]; then
    END_DATE=$(openssl x509 -enddate -noout \
        -in "/etc/letsencrypt/live/$DOMAIN/fullchain.pem" 2>/dev/null | cut -d= -f2)
    if [ -n "$END_DATE" ]; then
        END_EPOCH=$(date -d "$END_DATE" +%s 2>/dev/null)
        NOW_EPOCH=$(date +%s)
        DAYS_LEFT=$(( (END_EPOCH - NOW_EPOCH) / 86400 ))

        if [ "$DAYS_LEFT" -lt "$WARN_DAYS" ] && [ "$DAYS_LEFT" -ge 0 ]; then
            TODAY=$(date +%Y-%m-%d)
            LAST_WARN_FILE="$STATE_DIR/ssl_last_warn_alert"
            LAST_WARN=$(cat "$LAST_WARN_FILE" 2>/dev/null)
            if [ "$LAST_WARN" != "$TODAY" ]; then
                echo "$TODAY" > "$LAST_WARN_FILE"
                send_mail "[$HOSTNAME] SSL cert for ${DOMAIN} expires in $DAYS_LEFT days" \
"SSL CERTIFICATE EXPIRY WARNING

Server     : $HOSTNAME
Domain     : $DOMAIN
Expires    : $END_DATE
Days left  : $DAYS_LEFT (threshold: $WARN_DAYS)

Renewal either failed silently or has not yet run.
Run the MailX script -> option 15 to inspect, or option 16 to force renewal."
            fi
        fi
    fi
fi

exit 0
RENEWAL_EOF

    chmod +x /usr/local/bin/ssl_renewal.sh
    log_info "Renewal wrapper installed"

    log_info "Installing cron entries (03:17 + 15:17 daily)..."
    (
        crontab -l 2>/dev/null | grep -v "ssl_renewal.sh"
        echo "17 3 * * * /usr/local/bin/ssl_renewal.sh"
        echo "17 15 * * * /usr/local/bin/ssl_renewal.sh"
    ) | crontab - 2>/dev/null || true

    if systemctl list-unit-files 2>/dev/null | grep -q "^certbot.timer"; then
        systemctl enable --now certbot.timer 2>/dev/null || true
        log_info "certbot.timer enabled (systemd-native renewal)"
    fi

    echo ""
    log_info "Auto-renewal configuration summary:"
    echo "  Admin email      : $admin_email"
    echo "  Warning threshold: $warn_days days"
    echo "  Wrapper script   : /usr/local/bin/ssl_renewal.sh"
    echo "  Failure log      : /var/log/mailx/ssl_renewal_failures.log"
    echo ""

    if crontab -l 2>/dev/null | grep -q "ssl_renewal.sh"; then
        echo "  ✓ Cron entries installed:"
        crontab -l 2>/dev/null | grep "ssl_renewal.sh" | sed 's/^/    /'
    else
        echo "  ✗ Failed to install cron entries"
    fi
    echo ""

    read -p "Send a test notification email now? (y/n): " send_test
    if [[ "$send_test" == "y" ]]; then
        notify_ssl_failure "TEST notification from configure_ssl_autorenewal at $(date)"
        log_info "Test notification triggered — check $admin_email"
    fi

    echo ""
    log_info "SSL auto-renewal and notifications configured successfully."
    echo ""
}

server_public_ip() {
    local ip
    ip=$(curl -s --max-time 8 https://api.ipify.org 2>/dev/null || true)
    [ -z "$ip" ] && ip=$(curl -s --max-time 8 https://ifconfig.me 2>/dev/null || true)
    [ -z "$ip" ] && ip=$(hostname -I 2>/dev/null | awk '{print $1}')
    echo "$ip"
}

has_matching_a_record() {
    local host="$1" ip="$2" resolved
    [ -z "$host" ] && return 1
    resolved=$(getent ahostsv4 "$host" 2>/dev/null | awk 'NR==1 {print $1}')
    [ -n "$resolved" ] && [ "$resolved" = "$ip" ]
}

generate_self_signed_cert() {
    local hostname="$1" email_domain="$2"
    local dir="/etc/ssl/mailx"
    mkdir -p "$dir"
    [ -f "$dir/fullchain.pem" ] && [ -f "$dir/privkey.pem" ] && return 0
    openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
        -keyout "$dir/privkey.pem" -out "$dir/fullchain.pem" \
        -subj "/CN=$hostname" \
        -addext "subjectAltName=DNS:$hostname,DNS:$email_domain,DNS:admin.$email_domain" \
        2>/dev/null || openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
            -keyout "$dir/privkey.pem" -out "$dir/fullchain.pem" -subj "/CN=$hostname"
    chmod 600 "$dir/privkey.pem"
    chmod 644 "$dir/fullchain.pem"
}

apply_self_signed_cert() {
    postconf -e "smtpd_tls_cert_file=/etc/ssl/mailx/fullchain.pem"
    postconf -e "smtpd_tls_key_file=/etc/ssl/mailx/privkey.pem"
    systemctl reload-or-restart postfix dovecot 2>/dev/null || true
}

manage_ssl_certificates() {
    local action=$1
    local hostname=$2
    local email_domain=$3
    local mail_hostname=$4

    if [ -z "$hostname" ]; then
        hostname=$(cat /etc/mailname 2>/dev/null | tr -d '[:space:]')
        hostname="${hostname:-$(hostname -f 2>/dev/null || hostname)}"
    fi
    if [ -z "$email_domain" ]; then
        email_domain=$(cat /usr/local/roundcube_mail_domain.txt 2>/dev/null | tr -d '[:space:]')
    fi
    if [ -z "$mail_hostname" ]; then
        mail_hostname=$(cat /usr/local/roundcube_mail_hostname.txt 2>/dev/null | tr -d '[:space:]')
    fi

    local webroot="/var/www/html"
    local cert_name="$hostname"

    if [ -z "$hostname" ] || [ -z "$email_domain" ]; then
        log_error "No hostname/domain specified for SSL certificate"
        return 1
    fi

    case "$action" in
        install)
            if [ -d "/etc/letsencrypt/live/$cert_name" ]; then
                log_info "SSL certificate already installed for $cert_name"
                configure_ssl_services "$cert_name"
                return 0
            fi

            local server_ip a_ready
            server_ip=$(server_public_ip)
            a_ready=false
            if [ -n "$server_ip" ]; then
                for h in "$hostname" "$email_domain" "$mail_hostname" "admin.$email_domain"; do
                    [ -z "$h" ] && continue
                    if has_matching_a_record "$h" "$server_ip"; then
                        a_ready=true
                        break
                    fi
                done
            fi

            if [ "$a_ready" != "true" ]; then
                log_warning "No A record for $hostname / $email_domain resolves to this server ($server_ip)."
                log_warning "Generating a self-signed certificate instead of Let's Encrypt."
                generate_self_signed_cert "$hostname" "$email_domain"
                apply_self_signed_cert
                echo ""
                echo "=============================================================="
                echo "  WARNING: installed with a SELF-SIGNED certificate."
                echo "  No A record pointed at this server yet, so Let's Encrypt"
                echo "  was skipped. Browsers will warn until you set the A record"
                echo "  and re-run the SSL repair."
                echo "=============================================================="
                echo ""
                return 0
            fi

            if ! command -v certbot &> /dev/null; then
                log_info "Installing certbot..."
                apt_install certbot python3-certbot-apache
            fi

            mkdir -p "$webroot/.well-known/acme-challenge"
            chown -R www-data:www-data "$webroot"

            log_info "Attempting to install Let's Encrypt SSL certificate for $cert_name..."

            if retry_command "certbot certonly --webroot -w $webroot $(cert_domains "$hostname" "$email_domain" "$mail_hostname") --non-interactive --agree-tos --email admin@$email_domain --keep-until-expiring"; then
                configure_ssl_services "$cert_name"
                setup_ssl_renewal
                log_info "SSL certificate installed successfully"
                return 0
            else
                log_warning "SSL cert with admin.<domain> failed — trying without admin SAN"
                if retry_command "certbot certonly --webroot -w $webroot $(cert_domains "$hostname" "$email_domain" "$mail_hostname" 0) --non-interactive --agree-tos --email admin@$email_domain --keep-until-expiring"; then
                    configure_ssl_services "$cert_name"
                    setup_ssl_renewal
                    log_info "SSL certificate installed (without admin SAN)"
                    return 0
                fi
                log_error "Failed to obtain SSL certificate"
                return 1
            fi
            ;;

        renew)
            log_info "Renewing SSL certificates..."
            certbot renew --quiet --post-hook "systemctl reload postfix dovecot apache2" || true
            ;;

        change)
            if [[ -z "$hostname" || -z "$email_domain" ]]; then
                log_error "New hostname/domain not specified"
                return 1
            fi

            log_info "Changing SSL certificate to $hostname (domain $email_domain)..."
            certbot certonly --webroot -w "$webroot" \
                $(cert_domains "$hostname" "$email_domain" "$mail_hostname") \
                --non-interactive --agree-tos --email admin@$email_domain \
                --keep-until-expiring --force-renewal || true

            configure_ssl_services "$hostname"
            ;;

        *)
            log_error "Usage: manage_ssl_certificates [install|renew|change hostname email_domain [mail_hostname]]"
            return 1
            ;;
    esac
}

