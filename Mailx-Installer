log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

header() {
    echo ""
    echo -e "${BOLD}${CYAN}=== $* ===${NC}"
}

mark_stage_complete() {
    local stage=$1
    echo "$(date +%Y-%m-%d_%H:%M:%S)" > "$STATE_DIR/${stage}.completed"
    log_info "Stage '$stage' marked as complete"
}

is_stage_completed() {
    local stage=$1
