_svc_active()  { systemctl is-active --quiet "$1" 2>/dev/null; }
_svc_known()   { systemctl list-unit-files "${1}.service" 2>/dev/null | grep -q "${1}.service"; }
_installed()   { command -v "$1" >/dev/null 2>&1; }
_dir_present() { [ -d "$1" ]; }

_mailx_is_installed() { _installed postconf && _installed dovecot && _installed apache2; }

_mailx_domain() {
    cat /usr/local/roundcube_mail_domain.txt 2>/dev/null | tr -d '[:space:]'
}

_mailx_hostname() {
    local h
    h=$(cat /etc/mailname 2>/dev/null | tr -d '[:space:]')
    printf '%s' "${h:-$(hostname -f 2>/dev/null || hostname)}"
}

_ssl_expiry_summary() {
    local domain host cert=""
    domain=$(_mailx_domain)
    [ -z "$domain" ] && { echo "n/a"; return; }
    host=$(_mailx_hostname)
    if [ -f "/etc/letsencrypt/live/$host/fullchain.pem" ]; then
        cert="/etc/letsencrypt/live/$host/fullchain.pem"
    elif [ -f "/etc/letsencrypt/live/$domain/fullchain.pem" ]; then
        cert="/etc/letsencrypt/live/$domain/fullchain.pem"
    elif [ -f "/etc/ssl/mailx/fullchain.pem" ]; then
        cert="/etc/ssl/mailx/fullchain.pem"
    else
        echo "not installed"; return
    fi
    local end_epoch now_epoch days
    end_epoch=$(date -d "$(openssl x509 -in "$cert" -noout -enddate 2>/dev/null | cut -d= -f2)" +%s 2>/dev/null || echo 0)
    now_epoch=$(date +%s)
    [ "$end_epoch" -eq 0 ] && { echo "unreadable"; return; }
    days=$(( (end_epoch - now_epoch) / 86400 ))
    if [ "$days" -lt 0 ]; then echo "EXPIRED $(( -days ))d ago"
    elif [ "$days" -le 7 ]; then echo "CRITICAL ${days}d"
    elif [ "$days" -le 21 ]; then echo "WARNING ${days}d"
    else echo "OK ${days}d"; fi
}

# ============================================================================
# UFW firewall helpers
# ============================================================================

_ufw_exists() { command -v ufw >/dev/null 2>&1; }
_ufw_active() { _ufw_exists && ufw status 2>/dev/null | head -n1 | grep -qi '^Status: active'; }

_ufw_list_ports() {
    ufw status numbered 2>/dev/null | awk '
        /^\[[ 0-9]+\]/ {
            line=$0
            sub(/^\[[ ]*/, "", line)
            num=line; sub(/\].*/, "", num)
            rest=line; sub(/^[0-9]+\][ ]+/, "", rest)
            split(rest, a, /[ ]{2,}/)
            to=a[1]; action=a[2]; from=a[3]
            comment=""
            if (index(rest, "# ")) { comment=rest; sub(/.*# /, "", comment); sub(/[ ]+$/, "", comment) }
            printf "%s|%s|%s|%s|%s\n", num, to, action, from, comment
        }
    '
}

_ufw_validate_port() {
    local p="$1"
    [[ "$p" =~ ^[0-9]+$ ]] || return 1
    (( p >= 1 && p <= 65535 )) || return 1
}

_ufw_validate_proto() { [[ "$1" == "tcp" || "$1" == "udp" || "$1" == "any" ]]; }

_ufw_validate_cidr() {
    local c="$1"
    [ -z "$c" ] && return 0
    [ "$c" = "Anywhere" ] && return 0
    [[ "$c" =~ ^[0-9a-fA-F:.]+(/[0-9]{1,3})?$ ]] || return 1
    return 0
}

menu_firewall() {
    while true; do
        clear
        echo ""
        echo -e "=============================================="
        echo -e "   UFW Firewall Port Management"
        echo -e "=============================================="
        echo ""

        if ! _ufw_exists; then
            log_error "ufw is not installed."
            read -p "Install ufw now? (y/n): " a
            if [[ "${a:-n}" == "y" ]]; then
                apt-get update -qq && apt-get install -y -qq ufw && log_info "ufw installed."
            fi
            read -p "Press Enter to return..." _
            return 0
        fi

        local status
        if _ufw_active; then
            echo -e "  UFW status: ${GREEN}ACTIVE${NC}"
        else
            echo -e "  UFW status: ${YELLOW}INACTIVE${NC}"
        fi
        echo ""
        echo "  PORT RULES"
        echo "    1)  List all port rules"
        echo "    2)  Add a port rule"
        echo "    3)  Remove a port rule"
        echo "    4)  Add a port range rule"
        echo "    5)  Allow a port from a specific IP/CIDR only"
        echo ""
        echo "  UFW CONTROL"
        echo "    6)  Enable UFW"
        echo "    7)  Disable UFW"
        echo "    8)  Reload UFW (re-apply rules)"
        echo "    9)  Show raw 'ufw status verbose'"
        echo "   10)  Show default policies"
        echo ""
        echo "    0)  Back to main menu"
        echo ""
        read -p "Select: " ch
        case "$ch" in
            1) ufw_list_menu ;;
            2) ufw_add_port_menu ;;
            3) ufw_remove_port_menu ;;
            4) ufw_add_range_menu ;;
            5) ufw_allow_from_menu ;;
            6) ufw --force enable >/dev/null && log_info "UFW enabled."; read -p "Press Enter..." _ ;;
            7) ufw disable >/dev/null && log_info "UFW disabled."; read -p "Press Enter..." _ ;;
            8) ufw reload >/dev/null && log_info "UFW reloaded."; read -p "Press Enter..." _ ;;
            9) ufw status verbose | sed 's/^/  /'; read -p "Press Enter..." _ ;;
            10) ufw show default | sed 's/^/  /'; read -p "Press Enter..." _ ;;
            0) return 0 ;;
            *) log_warning "Invalid option."; sleep 1 ;;
        esac
    done
}

ufw_list_menu() {
    echo ""
    echo "=============================================="
    echo "   UFW Port Rules"
    echo "=============================================="
    _ufw_active || log_warning "UFW is inactive — showing configured rules (not enforced)."
    echo ""
    printf "%-4s %-22s %-12s %-22s %s\n" "NUM" "TO" "ACTION" "FROM" "COMMENT"
    printf "%-4s %-22s %-12s %-22s %s\n" "---" "----------------------" "------------" "----------------------" "-------"
    local count=0
    while IFS='|' read -r num to action from comment; do
        [ -z "$num" ] && continue
        printf "%-4s %-22s %-12s %-22s %s\n" "$num" "$to" "$action" "$from" "$comment"
        count=$((count+1))
    done < <(_ufw_list_ports)
    echo ""
    echo "  Total rules: ${count}"
    read -p "Press Enter..." _
}

ufw_add_port_menu() {
    echo ""
    echo "=============================================="
    echo "   Add Port Rule"
    echo "=============================================="
    local port proto comment from spec

    while true; do
        read -p "Port (1-65535): " port
        _ufw_validate_port "$port" && break
        log_warning "Invalid port."
    done
    while true; do
        read -p "Protocol [tcp/udp/any] (default tcp): " proto
        proto=${proto:-tcp}
        _ufw_validate_proto "$proto" && break
        log_warning "Must be tcp, udp, or any."
    done
    read -p "Comment (optional): " comment
    read -p "From (IP or CIDR, blank = Anywhere): " from

    if [ "$proto" = "any" ]; then spec="$port"; else spec="${port}/${proto}"; fi

    local cmd=(ufw allow)
    if [ -n "$from" ]; then
        cmd+=(from "$from" to any port "$port")
        [ "$proto" != "any" ] && cmd+=(proto "$proto")
    else
        cmd+=("$spec")
    fi
    [ -n "$comment" ] && cmd+=(comment "$comment")

    log_info "Running: ${cmd[*]}"
    if "${cmd[@]}"; then
        log_info "Port rule added."
        _ufw_list_ports | grep -F "|${spec}|" | sed 's/^/  /' || true
    else
        log_error "Failed to add rule."
    fi
    read -p "Press Enter..." _
}

ufw_add_range_menu() {
    echo ""
    echo "=============================================="
    echo "   Add Port Range Rule"
    echo "=============================================="
    local start end proto comment spec
    while true; do
        read -p "Start port (1-65535): " start
        _ufw_validate_port "$start" && break
        log_warning "Invalid start port."
    done
    while true; do
        read -p "End port (${start}-65535): " end
        _ufw_validate_port "$end" || { log_warning "Invalid end port."; continue; }
        (( end >= start )) || { log_warning "End must be >= start."; continue; }
        break
    done
    while true; do
        read -p "Protocol [tcp/udp/any] (default tcp): " proto
        proto=${proto:-tcp}
        _ufw_validate_proto "$proto" && break
        log_warning "Must be tcp, udp, or any."
    done
    read -p "Comment (optional): " comment

    spec="${start}:${end}"
    [ "$proto" != "any" ] && spec="${spec}/${proto}"

    local cmd=(ufw allow "$spec")
    [ -n "$comment" ] && cmd+=(comment "$comment")

    log_info "Running: ${cmd[*]}"
    if "${cmd[@]}"; then
        log_info "Port range rule added."
    else
        log_error "Failed to add range rule."
    fi
    read -p "Press Enter..." _
}

ufw_allow_from_menu() {
    echo ""
    echo "=============================================="
    echo "   Allow Port From Specific IP/CIDR"
    echo "=============================================="
    local port proto from comment
    while true; do
        read -p "Port (1-65535): " port
        _ufw_validate_port "$port" && break
        log_warning "Invalid port."
    done
    while true; do
        read -p "Protocol [tcp/udp/any] (default tcp): " proto
        proto=${proto:-tcp}
        _ufw_validate_proto "$proto" && break
        log_warning "Must be tcp, udp, or any."
    done
    while true; do
        read -p "From (IP or CIDR, required): " from
        [ -n "$from" ] || { log_warning "Required."; continue; }
        _ufw_validate_cidr "$from" && break
        log_warning "Looks invalid. Use e.g. 10.0.0.0/8 or 203.0.113.7"
    done
    read -p "Comment (optional): " comment

    local cmd=(ufw allow from "$from" to any port "$port")
    [ "$proto" != "any" ] && cmd+=(proto "$proto")
    [ -n "$comment" ] && cmd+=(comment "$comment")

    log_info "Running: ${cmd[*]}"
    if "${cmd[@]}"; then
        log_info "Restricted rule added."
    else
        log_error "Failed to add rule."
    fi
    read -p "Press Enter..." _
}

ufw_remove_port_menu() {
    echo ""
    echo "=============================================="
    echo "   Remove Port Rule"
    echo "=============================================="
    local lines
    lines=$(_ufw_list_ports)
    if [ -z "$lines" ]; then
        log_warning "No UFW rules found."
        read -p "Press Enter..." _; return 0
    fi

    printf "%-4s %-22s %-12s %-22s %s\n" "NUM" "TO" "ACTION" "FROM" "COMMENT"
    printf "%-4s %-22s %-12s %-22s %s\n" "---" "----------------------" "------------" "----------------------" "-------"
    while IFS='|' read -r num to action from comment; do
        [ -z "$num" ] && continue
        printf "%-4s %-22s %-12s %-22s %s\n" "$num" "$to" "$action" "$from" "$comment"
    done <<< "$lines"
    echo ""
    echo "  Remove by:"
    echo "    1) Rule NUMBER"
    echo "    2) Port specification (e.g. 5433/tcp)"
    echo "    0) Cancel"
    read -p "Select: " ch
    [ "$ch" = "0" ] && return 0

    case "$ch" in
        1)
            local num
            read -p "Rule number to delete: " num
            [[ "$num" =~ ^[0-9]+$ ]] || { log_warning "Numeric only."; read -p "Press Enter..." _; return 0; }
            echo ""
            log_info "About to delete rule [${num}]:"
            _ufw_list_ports | awk -F'|' -v n="$num" '$1==n {print "  TO="$2" ACTION="$3" FROM="$4" COMMENT="$5}'
            read -p "Confirm? (y/n): " c
            [[ "${c:-n}" == "y" ]] || { log_info "Cancelled."; read -p "Press Enter..." _; return 0; }
            if yes | ufw delete "$num" >/dev/null 2>&1; then
                log_info "Rule [${num}] deleted."
            else
                log_error "Failed to delete rule [${num}]."
            fi
            ;;
        2)
            local spec
            read -p "Port spec to delete (e.g. 5433/tcp, 80, 8000:8100/tcp): " spec
            [ -n "$spec" ] || { log_info "Cancelled."; read -p "Press Enter..." _; return 0; }
            log_info "Deleting rule for: ${spec}"
            if ufw delete allow "$spec" >/dev/null 2>&1; then
                log_info "Rule for '${spec}' deleted."
            else
                log_warning "Could not delete '${spec}'. It may be a restricted rule (use rule number)."
            fi
            ;;
        *) log_warning "Invalid." ;;
    esac
    read -p "Press Enter..." _
}

