# User Management
# ============================================================================

register_mailbox_in_panel() {
    local email=$1
    local quota_size=${2:-1024}
    local password=${3:-}

    if [ ! -x "$ADMIN_BINARY_PATH" ] || [ ! -f "$ADMIN_CONFIG_FILE" ]; then
        log_info "Panel not installed yet — $email will be imported (with its /etc/shadow hash) when the panel is seeded"
        log_info "If webmail refuses $email after the install, set its password again in the panel (Users)"
        return 0
    fi

    if [ ${#password} -lt 8 ]; then
        if [ -n "$password" ]; then
            log_warning "Password for $email is shorter than the panel's 8-character minimum"
            log_warning "Registering it with its /etc/shadow hash instead; re-set the password in the panel to be sure of the login"
        fi
        password=""
    fi

    local out registered=0
    if [ -n "$password" ]; then
        if out=$(printf '%s\n' "$password" | "$ADMIN_BINARY_PATH" mailbox add "$email" \
                    --kind system --quota "$quota_size" --password-stdin \
                    --config "$ADMIN_CONFIG_FILE" 2>&1); then
            registered=1
        fi
    else
        if out=$("$ADMIN_BINARY_PATH" mailbox add "$email" \
                    --kind system --quota "$quota_size" \
                    --config "$ADMIN_CONFIG_FILE" 2>&1); then
            registered=1
        fi
    fi

    if [ "$registered" -eq 1 ]; then
        echo "$out" | tee -a "$LOG_FILE"
        log_info "Mailbox $email registered in the panel"
        return 0
    fi

    echo "$out" | tee -a "$LOG_FILE"
    log_warning "Could not register $email in the panel."
    log_warning "The Unix account and its maildir are fine. Finish with:"
    log_warning "    mailx-admin mailbox add $email --kind system --password-stdin --config $ADMIN_CONFIG_FILE"
    log_warning "    (pipe the account's password in on standard input)"
    return 1
}

verify_login() {
    local address=$1
    local password=$2

    if ! command -v doveadm >/dev/null 2>&1; then
        log_warning "doveadm not found, cannot verify the login for $address"
        return 2
    fi

    local out
    if out=$(doveadm auth test "$address" "$password" 2>&1); then
        echo "$out" | tee -a "$LOG_FILE"
        log_info "Login verified: $address authenticates against Dovecot"
        return 0
    fi

    echo "$out" | tee -a "$LOG_FILE"
    log_error "LOGIN VERIFICATION FAILED for $address - webmail will refuse this account."
    log_error "Check, in this order:"
    log_error "  1. doveadm pw -l                 what this Dovecot can verify"
    log_error "  2. grep '^$address' /etc/dovecot/users    is the mailbox in the passwd file"
    log_error "  3. $ADMIN_BINARY_PATH doctor     hash scheme, passwd file, Roundcube"
    return 1
}

add_roundcube_user() {
    local username=$1
    local password=$2
    local quota_size=$3
    local domain=$(cat /usr/local/roundcube_mail_domain.txt 2>/dev/null | tr -d '[:space:]')
    local email="$username@$domain"
    local ROUNDCUBE_DB_USER="roundcube"
    local ROUNDCUBE_DB_NAME="roundcubemail"

    if id "$username" >/dev/null 2>&1; then
        log_info "User $username already exists, skipping creation..."
        register_mailbox_in_panel "$email" "$quota_size" "$password" || true
        return 0
    fi

    useradd -m -s /bin/bash "$username"
    echo "$username:$password" | chpasswd

    mkdir -p "/home/$username/Maildir/"{cur,new,tmp}
    chown -R "$username:$username" "/home/$username/Maildir"

    echo "quota_rule = *:storage=${quota_size}M" > "/home/$username/.dovecot.quota"
    chown "$username:$username" "/home/$username/.dovecot.quota"

    register_mailbox_in_panel "$email" "$quota_size" "$password" || true

    ROUNDCUBE_PREFERENCE='a:6:{s:14:"compose_extwin";i:1;s:10:"htmleditor";i:1;s:11:"mdn_default";b:0;s:11:"dsn_default";b:0;s:13:"sig_separator";b:0;s:25:"compose_save_localstorage";i:1;}'

    USER_ID=$(mysql $ROUNDCUBE_DB_NAME -se "INSERT INTO users (username, mail_host, created, last_login, language, preferences) VALUES ('$username', 'localhost', NOW(), NOW(), 'en_GB', '$ROUNDCUBE_PREFERENCE'); SELECT LAST_INSERT_ID();" 2>/dev/null || echo "")

    if [ -n "$USER_ID" ]; then
        mysql $ROUNDCUBE_DB_NAME -e "INSERT INTO identities (user_id, changed, del, standard, name, organization, email, \`reply-to\`, signature, html_signature) VALUES ('$USER_ID', NOW(), '0', '1', '$username', 'localhost', '$email', '$email', '', '1');" 2>/dev/null || true
    fi

    systemctl restart postfix dovecot 2>/dev/null || true

    verify_login "$email" "$password" || true

    send_welcome_email "$email" "$username"

    log_info "User $username created successfully with email $email"
}

send_welcome_email() {
    local recipient_email=$1
    local roundcube_user=$2
    local domain=$(cat /usr/local/roundcube_mail_domain.txt 2>/dev/null | tr -d '[:space:]')
    [ -z "$domain" ] && domain="localhost"

    local subject="Welcome to Roundcube Webmail, $roundcube_user"
    local body="Dear User,\n\nCongratulations! Your Roundcube email has been successfully set up.\n\nHere are your login details:\n\nWebmail login: $recipient_email\n\nYou can access your Roundcube webmail interface anytime\n\nThank you,\nAdmin Team"

    echo -e "$body" | mail -s "$subject" -a "From: admin@$domain" "$recipient_email" 2>/dev/null || true
}

