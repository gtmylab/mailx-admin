    18)
        echo ""
        echo "=============================================="
        echo "   MailX Admin Panel"
        echo "=============================================="
        echo ""
        panel_domain=$(cat /usr/local/roundcube_mail_domain.txt 2>/dev/null | tr -d '[:space:]')
        echo "URL:           https://admin.${panel_domain}:${ADMIN_WEB_PORT}"
        echo "Local URL:     http://${ADMIN_LISTEN_ADDR}"
        echo "Config:        ${ADMIN_CONFIG_FILE}"
        echo "Service:       systemctl status ${ADMIN_SERVICE_NAME}"
        echo "Logs:          journalctl -u ${ADMIN_SERVICE_NAME} -f"
        echo ""
        if [ -f /root/.mailx-admin-initial-password ]; then
            echo "Initial admin credentials:"
            echo "  Username: admin"
            echo "  Password: $(cat /root/.mailx-admin-initial-password)"
            echo ""
            echo "  (Change this immediately after first login.)"
        else
            echo "Initial password file not found."
            echo "Reset with: mailx-admin user passwd admin --config ${ADMIN_CONFIG_FILE}"
        fi
        echo ""
        ;;

    19)
        log_info "Restarting mailx-admin service..."
        systemctl restart "${ADMIN_SERVICE_NAME}" && \
            log_info "Restarted successfully" || \
            log_error "Restart failed — check journalctl -u ${ADMIN_SERVICE_NAME}"
        ;;

    20)
        echo "Exiting."
        exit 0
        ;;

    21)
        repair_admin_panel_web
        ;;

    22)
        update_mailx_admin
        ;;

    23)
        web_host=$(cat /etc/mailname 2>/dev/null | tr -d '[:space:]')
        web_host="${web_host:-$(hostname -f 2>/dev/null || hostname)}"
        write_roundcube_ssl_vhost "$web_host"
        log_info "Roundcube webmail now serves HTTPS on 8080 (https://${web_host}:8080)"
        ;;

    24)
        setup_composer_and_roundcube_user
        ;;

    25)
        install_roundcube_plugins
        ;;

    *)
        log_error "Invalid choice. Exiting."
        exit 1
        ;;
esac
