# Where to fetch the binary from.
# Override with: MAILX_ADMIN_BINARY_URL=... ./installer.sh
# Or place a file at /tmp/mailx-admin before running the installer.
# The published release asset is linux-amd64. Keep its name in one place: it is
# used for the download URL and for the SHA256SUMS entry lookup.
ADMIN_BINARY_ASSET="mailx-admin-linux-amd64"
ADMIN_BINARY_URL="${MAILX_ADMIN_BINARY_URL:-https://github.com/gtmylab/mailx-admin/releases/latest/download/${ADMIN_BINARY_ASSET}}"
ADMIN_BINARY_SHA_URL="${MAILX_ADMIN_SHA_URL:-https://github.com/gtmylab/mailx-admin/releases/latest/download/SHA256SUMS}"
ADMIN_BINARY_LOCAL="${MAILX_ADMIN_BINARY_LOCAL:-/tmp/mailx-admin}"

# ============================================================================
# Utility Functions
# ============================================================================

log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

mark_stage_complete() {
    local stage=$1
    echo "$(date +%Y-%m-%d_%H:%M:%S)" > "$STATE_DIR/${stage}.completed"
    log_info "Stage '$stage' marked as complete"
}

is_stage_completed() {
    local stage=$1
    [ -f "$STATE_DIR/${stage}.completed" ]
}

file_exists_and_not_empty() {
    [ -f "$1" ] && [ -s "$1" ]
}

is_service_running() {
    systemctl is-active --quiet "$1" 2>/dev/null
}

is_package_installed() {
    dpkg -l "$1" 2>/dev/null | grep -q "^ii"
}

check_string_in_file() {
    local file=$1
    local string=$2
    grep -qF "$string" "$file" 2>/dev/null
}

generate_blowfish_secret() {
    tr -dc 'a-zA-Z0-9./' < /dev/urandom | fold -w 32 | head -n 1
}

generate_password() {
    local length=$1
    local chars="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
    local password=""
    for i in $(seq 1 $length); do
        password+=$(echo $chars | fold -w1 | shuf | head -n1)
    done
    echo $password
}

retrieve_file_data() {
    local filepath=$1
    if [ -f "$filepath" ]; then
        cat "$filepath"
    else
        log_error "Error: Password file $filepath not found."
        exit 1
    fi
}

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Download a binary, verify it's executable, and install it.
# Accepts: a local path (if file exists), otherwise a URL.
# $5 (optional) is a SHA256SUMS-style URL: when given, the downloaded file must
# match the entry named $4 before it is installed.
install_binary_from_url() {
    local url=$1
    local local_path=$2
    local target=$3
    local expected_name=$4
    local checksums_url=$5

    if [ -f "$local_path" ] && [ -s "$local_path" ]; then
        log_info "Using local binary at $local_path for $expected_name"
        install -m 0755 "$local_path" "$target"
        return 0
    fi

    log_info "Downloading $expected_name from $url"
    if ! retry_command "wget -q --timeout=60 --tries=3 -O ${target}.tmp $url"; then
        log_error "Failed to download $expected_name"
        rm -f "${target}.tmp"
        return 1
    fi

    if [ ! -s "${target}.tmp" ]; then
        log_error "Downloaded $expected_name is empty"
        rm -f "${target}.tmp"
        return 1
    fi

    # Sanity check: does it look like a Linux ELF binary?
    if ! head -c 4 "${target}.tmp" | grep -q $'\x7fELF'; then
        log_warning "$expected_name does not look like a Linux ELF binary — continuing anyway"
    fi

    # Integrity check against the release's SHA256SUMS, when one is configured.
    # An unreachable/missing checksum is non-fatal (offline mirrors, custom
    # builds), but a MISMATCH is fatal so a truncated or substituted download
    # never reaches /usr/local/bin.
    if [ -n "$checksums_url" ]; then
        local expected_sha=""
        expected_sha=$(wget -qO- --timeout=30 "$checksums_url" 2>/dev/null | \
            awk -v n="$expected_name" '$2 == n || $2 == "*" n { print $1; exit }')

        if [ -z "$expected_sha" ]; then
            log_warning "No checksum for $expected_name in $checksums_url - skipping verification"
        else
            local actual_sha=""
            actual_sha=$(sha256sum "${target}.tmp" 2>/dev/null | awk '{ print $1 }')
            if [ "$actual_sha" != "$expected_sha" ]; then
                log_error "Checksum mismatch for $expected_name"
                log_error "  expected: $expected_sha"
                log_error "  actual:   $actual_sha"
                rm -f "${target}.tmp"
                return 1
            fi
            log_info "Checksum verified for $expected_name (sha256 ${actual_sha:0:12}...)"
        fi
    fi

    mv "${target}.tmp" "$target"
    chmod 0755 "$target"
    return 0
}

# ============================================================================
# Enhanced Error Handling and Retry Logic
# ============================================================================

hide_output() {
    local OUTPUT=$(mktemp)
    set +e
    "$@" &> "$OUTPUT"
    local E=$?
    set -e

    if [ $E != 0 ]; then
        if grep -q "Could not resolve host\|Connection refused\|Connection timed out\|Network is unreachable" "$OUTPUT" 2>/dev/null; then
            log_warning "Network error detected: $(head -1 "$OUTPUT")"
            rm -f "$OUTPUT"
            return 1
        elif grep -q "dpkg was interrupted\|dpkg --configure -a" "$OUTPUT" 2>/dev/null; then
            log_warning "Package manager interrupted. Running dpkg --configure -a..."
            dpkg --configure -a
            rm -f "$OUTPUT"
            return 1
        else
            log_error "FAILED: $*"
            echo "----------------------------------------"
            cat "$OUTPUT"
            echo "----------------------------------------"
            if grep -q "Unable to locate package" "$OUTPUT" 2>/dev/null; then
                log_warning "A package name is not provided by this release's repositories (Debian/Ubuntu rename sub-packages between releases)."
            fi
            rm -f "$OUTPUT"
            exit $E
        fi
    fi
    rm -f "$OUTPUT"
    return 0
}

retry_command() {
    local max_attempts=7
    local attempt=1
    local delay=10
    local command="$@"

    while [ $attempt -le $max_attempts ]; do
        if eval "$command" 2>&1; then
            return 0
        fi

        log_warning "Command failed (attempt $attempt/$max_attempts). Retrying in $delay seconds..."
        sleep $delay
        attempt=$((attempt + 1))
        delay=$((delay * 2))
    done

    log_error "Command failed after $max_attempts attempts: $command"
    return 1
}

apt_get_quiet() {
    DEBIAN_FRONTEND=noninteractive hide_output apt-get -y -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confnew" "$@"
}

# Debian/Ubuntu rename or split sub-packages between releases. The Dovecot LMTP
# service has always been "dovecot-lmtpd" ("dovecot-lmtp" does not exist), and
# "dovecot-managesieved" was "dovecot-managesieve" on older releases.
# Returns the candidate names for a package, primary name first.
apt_package_candidates() {
    case "$1" in
        dovecot-lmtp)         echo "dovecot-lmtpd" ;;
        dovecot-managesieved) echo "dovecot-managesieved dovecot-managesieve" ;;
        *)                    echo "$1" ;;
    esac
}

apt_package_available() {
    apt-cache show "$1" >/dev/null 2>&1
}

# Echo the name the current apt sources actually provide, or return 1.
resolve_apt_package() {
    local candidate
    for candidate in $(apt_package_candidates "$1"); do
        if apt_package_available "$candidate"; then
            echo "$candidate"
            return 0
        fi
    done
    return 1
}

APT_INDEX_REFRESHED=0

refresh_apt_index_once() {
    [ "$APT_INDEX_REFRESHED" -eq 1 ] && return 0
    APT_INDEX_REFRESHED=1
    log_info "Refreshing package index (apt-get update)..."
    DEBIAN_FRONTEND=noninteractive apt-get -qq update >/dev/null 2>&1 || true
}

apt_install() {
    local pkg resolved
    local -a wanted=() unresolved=()

    for pkg in "$@"; do
        if resolved="$(resolve_apt_package "$pkg")"; then
            wanted+=("$resolved")
        else
            unresolved+=("$pkg")
        fi
    done

    # An unknown name is usually a stale package index: refresh once, then hand
    # anything still unknown to apt unchanged (it may be a virtual package that
    # apt-cache show cannot list, e.g. mysql-client on some releases).
    if [ ${#unresolved[@]} -gt 0 ]; then
        refresh_apt_index_once
        for pkg in "${unresolved[@]}"; do
            if resolved="$(resolve_apt_package "$pkg")"; then
                wanted+=("$resolved")
            else
                wanted+=("$pkg")
            fi
        done
    fi

    log_info "Installing packages: ${wanted[*]}"
    retry_command apt_get_quiet install "${wanted[@]}"
}

restart_service() {
    log_info "Restarting service: $1"
    hide_output service "$1" restart
}

# ============================================================================
# Configuration Functions
