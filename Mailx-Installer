rc_set_config() {
    local file=$1 key=$2 value=$3

    if grep -qF "\$config['$key']" "$file"; then
        sed -i -E "s|^[[:space:]]*(//)?[[:space:]]*[$]config\['$key'\].*|\$config['$key'] = $value;|" "$file"
        return
    fi

    if grep -qF '?>' "$file"; then
        sed -i -E "/^[?]>/i \$config['$key'] = $value;" "$file"
    else
        printf '%s\n' "\$config['$key'] = $value;" >> "$file"
    fi
}

rc_enable_plugin() {
    local file=$1 plugin=$2

    [ -f "$file" ] || return 1

    if grep -qF "'$plugin'" "$file"; then
        return 0
    fi

    if grep -qF "\$config['plugins'] = array();" "$file"; then
        sed -i "s|[$]config\['plugins'\] = array();|\$config['plugins'] = ['$plugin'];|" "$file"
        return 0
    fi

    if grep -qF "\$config['plugins'] = [" "$file"; then
        sed -i "s|[$]config\['plugins'\] = \[|\$config['plugins'] = [\n    '$plugin',|" "$file"
        return 0
    fi

    # Older Roundcube samples use array(...) instead of [...]; appending a
    # second assignment would silently disable every plugin the operator had
    # enabled, so extend the existing call instead.
    if grep -qF "\$config['plugins'] = array(" "$file"; then
        sed -i "s|[$]config\['plugins'\] = array(|\$config['plugins'] = array(\n    '$plugin',|" "$file"
        return 0
    fi

    printf '%s\n' "\$config['plugins'] = ['$plugin'];" >> "$file"
}

# rc_configure_managesieve points Roundcube at the managesieved this installer
# starts, and enables the plugin that talks to it.
#
# Both halves were missing and either one breaks the Filters page: without the
# plugin there is no UI at all, and with the plugin but no host/port Roundcube
# defaults to STARTTLS on port 4190, which this managesieved does not offer --
# saving a filter then fails with "Unable to connect".
#
# It is a function rather than two lines inline because install_roundcube_application
# returns early for an existing installation, and that early return is exactly
# where an upgrade has to be able to repair the configuration.
rc_configure_managesieve() {
    local file=$1

    [ -f "$file" ] || return 1

    rc_set_config "$file" managesieve_host "'127.0.0.1'"
    rc_set_config "$file" managesieve_port "4190"
    rc_set_config "$file" managesieve_usetls "false"
    rc_enable_plugin "$file" managesieve

    log_info "Roundcube managesieve plugin enabled (127.0.0.1:4190)"
}

install_roundcube_application() {
    local EMAIL_DOMAIN=$1
    local HOSTNAME=$2

    log_info "=== Stage 9: Roundcube Installation ==="

    local ROUNDCUBE_DB_PASSWORD=$(cat /usr/local/roundcube_db_pwd.txt)
    local ROUNDCUBE_DB_USER="roundcube"
    local ROUNDCUBE_DB_NAME="roundcubemail"
    local ROUNDCUBE_ADMIN_EMAIL="admin@$EMAIL_DOMAIN"
    local ROUNDCUBE_ADMIN_PASS=$(openssl rand -base64 12)

    local CURRENT_DIR=$(pwd)

    cd /var/www/html || {
        log_error "Failed to change to /var/www/html"
        return 1
    }

    if [ -d "roundcube" ] && [ ! -f "roundcube/config/config.inc.php" ]; then
        log_info "Removing incomplete Roundcube installation..."
        rm -rf roundcube
    fi

    if [ -d "roundcube" ] && [ -f "roundcube/config/config.inc.php" ]; then
        log_info "Roundcube already installed, verifying configuration..."
        if grep -q "db_dsnw" roundcube/config/config.inc.php 2>/dev/null; then
            log_info "Roundcube already properly configured, skipping..."
            # Not a full skip: earlier versions of this installer never
            # enabled the managesieve plugin, so a re-run has to repair it.
            rc_configure_managesieve roundcube/config/config.inc.php
            cd "$CURRENT_DIR" 2>/dev/null || true
            return 0
        else
            log_warning "Roundcube installed but config incomplete, reconfiguring..."
        fi
    fi

    log_info "Downloading Roundcube..."
    local RC_VERSION="1.6.11"
    local RC_FILE="roundcubemail-${RC_VERSION}-complete.tar.gz"
    local RC_URL="https://github.com/roundcube/roundcubemail/releases/download/${RC_VERSION}/${RC_FILE}"

    [ -f "$RC_FILE" ] && rm -f "$RC_FILE"

    local download_success=false
    for i in {1..3}; do
        if wget -q --timeout=30 --tries=3 "$RC_URL" -O "$RC_FILE" 2>/dev/null; then
            if [ -s "$RC_FILE" ]; then
                download_success=true
                break
            fi
        fi
        log_warning "Download attempt $i failed, retrying..."
        sleep 5
    done

    if [ "$download_success" != "true" ]; then
        log_error "Failed to download Roundcube"
        cd "$CURRENT_DIR" 2>/dev/null || true
        return 1
    fi

    log_info "Extracting Roundcube..."
    if ! tar -xzf "$RC_FILE" 2>/dev/null; then
        log_error "Failed to extract Roundcube"
        rm -f "$RC_FILE"
        cd "$CURRENT_DIR" 2>/dev/null || true
        return 1
    fi

    local extracted_dir=""
    for dir in roundcubemail-*/; do
        if [ -d "$dir" ]; then
            extracted_dir="${dir%/}"
            break
        fi
    done

    if [ -z "$extracted_dir" ]; then
        log_error "Could not find extracted Roundcube directory"
        rm -f "$RC_FILE"
        cd "$CURRENT_DIR" 2>/dev/null || true
        return 1
    fi

    [ -d "roundcube" ] && rm -rf roundcube

    mv "$extracted_dir" roundcube || {
        log_error "Failed to move Roundcube to final location"
        rm -f "$RC_FILE"
        cd "$CURRENT_DIR" 2>/dev/null || true
        return 1
    }

    rm -f "$RC_FILE"

    cd roundcube || {
        log_error "Failed to change to roundcube directory"
        cd "$CURRENT_DIR" 2>/dev/null || true
        return 1
    }

    if [ ! -d "config" ]; then
        log_error "Config directory not found in Roundcube installation"
        cd "$CURRENT_DIR" 2>/dev/null || true
        return 1
    fi

    if [ -f "config/config.inc.php.sample" ]; then
        cp config/config.inc.php.sample config/config.inc.php
        log_info "Config file created from sample"
    else
        log_warning "Config sample not found, creating default config..."
        cat > config/config.inc.php <<'EOF'
<?php
$config = array();
$config['db_dsnw'] = '';
$config['default_host'] = 'localhost';
$config['smtp_server'] = 'localhost';
$config['smtp_port'] = 25;
$config['support_url'] = '';
$config['mail_domain'] = '';
$config['product_name'] = 'Roundcube Webmail';
$config['des_key'] = '';
$config['plugins'] = array();
$config['skin'] = 'elastic';
?>
EOF
    fi

    log_info "Configuring Roundcube database..."
    rc_set_config config/config.inc.php db_dsnw "'mysql://$ROUNDCUBE_DB_USER:$ROUNDCUBE_DB_PASSWORD@localhost/$ROUNDCUBE_DB_NAME'"

    rc_set_config config/config.inc.php default_host "'localhost'"
    rc_set_config config/config.inc.php smtp_server "'localhost'"
    rc_set_config config/config.inc.php smtp_port "25"
    rc_set_config config/config.inc.php support_url "'mailto:$ROUNDCUBE_ADMIN_EMAIL'"
    rc_set_config config/config.inc.php mail_domain "'$EMAIL_DOMAIN'"

    # Filters: Roundcube talks to managesieved on the loopback address. The
    # panel writes the sieve files itself, but a user who wants to edit them in
    # the webmail needs the plugin that speaks ManageSieve, and it is useless
    # without the host/port/TLS it should use.
    rc_configure_managesieve config/config.inc.php

    if grep -qE "^[[:space:]]*//?[[:space:]]*[$]config\['des_key'\][[:space:]]*=[[:space:]]*'';" config/config.inc.php; then
        local DES_KEY=$(openssl rand -base64 24)
        rc_set_config config/config.inc.php des_key "'$DES_KEY'"
    fi

    log_info "Initializing Roundcube database schema..."
    if [ -f "bin/initdb.sh" ]; then
        chmod +x bin/initdb.sh
        if ! ./bin/initdb.sh --dir=./SQL --create 2>/dev/null; then
            log_warning "Database initialization had issues, but continuing..."
        fi
    else
        log_warning "initdb.sh not found, skipping database initialization"
    fi

    log_info "Setting Roundcube permissions..."
    chown -R www-data:www-data . 2>/dev/null || true
    find . -type d -exec chmod 755 {} \; 2>/dev/null || true
    find . -type f -exec chmod 644 {} \; 2>/dev/null || true
    chmod 775 temp logs 2>/dev/null || true

    setup_composer_and_roundcube_user

    log_info "Adding admin user..."
    add_roundcube_user "admin" "$ROUNDCUBE_ADMIN_PASS" 1000

    cd "$CURRENT_DIR" 2>/dev/null || true

    if [ -f "/var/www/html/roundcube/config/config.inc.php" ]; then
        log_info "Roundcube installation completed successfully"
        return 0
    else
        log_error "Roundcube installation verification failed"
        return 1
    fi
}

setup_composer_and_roundcube_user() {
    log_info "=== Composer & Roundcube user setup ==="
    log_info "php: $(command -v php 2>/dev/null || echo missing), composer: $(command -v composer 2>/dev/null || echo missing)"

    if ! command -v php >/dev/null 2>&1; then
        log_error "php CLI not found; install a php*-cli package first"
        return 1
    fi

    if ! command -v composer >/dev/null 2>&1; then
        log_info "Installing Composer (downloading installer, needs outbound network)..."
        cd /tmp || return 1
        wget -q --timeout=30 --tries=3 -O composer-setup.php https://getcomposer.org/installer \
            || { log_error "failed to download Composer installer (check outbound network)"; return 1; }
        wget -q --timeout=30 --tries=3 -O composer-setup.sig https://composer.github.io/installer.sig \
            || { log_error "failed to download Composer signature"; return 1; }
        local EXPECTED ACTUAL
        EXPECTED=$(php -r "echo trim(file_get_contents('composer-setup.sig'));")
        ACTUAL=$(php -r "echo hash_file('sha384', 'composer-setup.php');")
        if [ "$EXPECTED" != "$ACTUAL" ]; then
            log_error "Composer installer hash mismatch (expected $EXPECTED, got $ACTUAL)"
            rm -f composer-setup.php composer-setup.sig
            return 1
        fi
        log_info "Installing Composer to /usr/local/bin/composer..."
        php -d default_socket_timeout=30 composer-setup.php --install-dir=/usr/local/bin --filename=composer \
            || { log_error "Composer install failed"; rm -f composer-setup.php composer-setup.sig; return 1; }
        rm -f composer-setup.php composer-setup.sig
    fi
    command -v composer >/dev/null 2>&1 || { log_error "composer still unavailable"; return 1; }
    log_info "Composer: $(timeout 15 composer --version 2>/dev/null || echo 'unavailable')"

    if ! id -u "$ROUNDCUBE_COMPOSER_USER" >/dev/null 2>&1; then
        useradd --create-home --home-dir "$ROUNDCUBE_COMPOSER_HOME" \
            --shell /bin/bash "$ROUNDCUBE_COMPOSER_USER"
        log_info "Created user: $ROUNDCUBE_COMPOSER_USER"
    fi
    echo "${ROUNDCUBE_COMPOSER_USER}:${ROUNDCUBE_COMPOSER_PASSWORD}" | chpasswd

    if [ -d /var/www/html/roundcube ]; then
        chown -R "$ROUNDCUBE_COMPOSER_USER":"$ROUNDCUBE_COMPOSER_USER" /var/www/html/roundcube
        for d in temp logs; do
            [ -d "/var/www/html/roundcube/$d" ] && chown -R www-data:www-data "/var/www/html/roundcube/$d"
        done
    fi

    if [ -f /var/www/html/roundcube/composer.json ]; then
        cd /var/www/html/roundcube || return 1
        log_info "Reconciling Composer (first run downloads packages, can take a few minutes)..."
        if ! timeout 900 sudo -H -u "$ROUNDCUBE_COMPOSER_USER" composer install --no-interaction --no-progress --no-dev; then
            log_warning "composer install failed: plugins will not install until this succeeds"
        fi
    else
        log_warning "/var/www/html/roundcube/composer.json not found: skipping composer reconcile"
    fi

    timeout 15 sudo -H -u "$ROUNDCUBE_COMPOSER_USER" composer --version 2>/dev/null || true
    log_info "Composer & Roundcube user setup complete"
}

install_roundcube_plugins() {
    setup_composer_and_roundcube_user || return 1

    local RC_DIR="/var/www/html/roundcube"
    [ -f "$RC_DIR/composer.json" ] || {
        log_error "Roundcube not installed ($RC_DIR/composer.json missing)"; return 1
    }

    local PLUGINS=(
        "hercegdoo/aicomposeplugin|AI Compose|"
        "texxasrulez/spfstatus|SPF Status|"
        "texxasrulez/password|Password|choose a password driver in Settings > Password"
        "texxasrulez/folder_info|Folder Info|"
        "jfcherng-roundcube/cloudview|Cloud View|"
        "texxasrulez/scheduled_sending|Scheduled Sending|"
        "gecka/ident-switch|Identity Switch|"
        "kitist/html5_notifier|HTML5 Notifier|"
        "texxasrulez/advanced_search|Advanced Search|"
        "texxasrulez/additional_imap|Additional IMAP|"
        "texxasrulez/rc_shield|RC Shield|"
        "gianlucagiacometti/roundcube-toolbox|Roundcube Toolbox|"
        "jfcherng-roundcube/show-folder-size|Show Folder Size|"
        "jfcherng-roundcube/quota|Quota|"
        "texxasrulez/account_details|Account Details|"
        "prefo-pl/email_notes|Email Notes|"
        "pf4public/fetchmail|Fetchmail|add a periodic fetch cron (see its README)"
        "dsoares/removeattachments|Remove Attachments|"
        "cymdeveloppement/roundcube-ai|Roundcube AI|set provider + API key in its settings"
    )

    echo
    echo "Available Roundcube plugins:"
    local i=1 entry label note
    for entry in "${PLUGINS[@]}"; do
        label="${entry#*|}"; label="${label%%|*}"
        note="${entry##*|}"
        if [ -n "$note" ]; then
            printf "  %2d) %s  [needs setup: %s]\n" "$i" "$label" "$note"
        else
            printf "  %2d) %s\n" "$i" "$label"
        fi
        i=$((i+1))
    done
    echo

    local selection
    read -p "Enter plugin number(s) to install (space-separated, 'all', or 'q' to cancel): " selection
    [ -z "$selection" ] && { echo "No plugins selected."; return 0; }
    [ "$selection" = "q" ] && return 0

    local selected=()
    if [ "$selection" = "all" ]; then
        for ((idx=0; idx<${#PLUGINS[@]}; idx++)); do selected+=("$idx"); done
    else
        local tok
        for tok in $selection; do
            case "$tok" in
                ''|*[!0-9]*) log_error "Invalid choice: '$tok'"; return 1 ;;
            esac
            if [ "$tok" -ge 1 ] && [ "$tok" -le "${#PLUGINS[@]}" ]; then
                selected+=("$((tok-1))")
            else
                log_error "Out of range: $tok"; return 1
            fi
        done
    fi

    local idx pkg before after d
    for idx in "${selected[@]}"; do
        entry="${PLUGINS[$idx]}"
        pkg="${entry%%|*}"
        label="${entry#*|}"; label="${label%%|*}"
        note="${entry##*|}"
        log_info "Installing $label ($pkg)..."
        before=$(ls "$RC_DIR/plugins" 2>/dev/null | sort)
        cd "$RC_DIR" || return 1
        if timeout 300 sudo -H -u "$ROUNDCUBE_COMPOSER_USER" composer require "$pkg" --no-interaction --no-progress --no-ansi; then
            after=$(ls "$RC_DIR/plugins" 2>/dev/null | sort)
            while IFS= read -r d; do
                [ -n "$d" ] && rc_enable_plugin "$RC_DIR/config/config.inc.php" "$d"
            done < <(comm -13 <(printf '%s\n' "$before") <(printf '%s\n' "$after"))
            log_info "Installed and enabled $label ($pkg)"
            [ -n "$note" ] && log_warning "  $label still needs setup: $note"
        else
            log_error "Failed to install $pkg"
        fi
    done

    log_info "Roundcube plugin installation finished. Re-run to retry failures or add more."
}

verify_roundcube_installation() {
    local EMAIL_DOMAIN=$1

    log_info "Verifying Roundcube installation..."

    if [ ! -d "/var/www/html/roundcube" ]; then
        log_error "Roundcube directory not found"
        return 1
    fi

    if [ ! -f "/var/www/html/roundcube/config/config.inc.php" ]; then
        log_error "Roundcube config file not found"
        return 1
    fi

    local ROUNDCUBE_DB_PASSWORD=$(cat /usr/local/roundcube_db_pwd.txt)
    local ROUNDCUBE_DB_USER="roundcube"
    local ROUNDCUBE_DB_NAME="roundcubemail"

    if mysql -u "$ROUNDCUBE_DB_USER" -p"$ROUNDCUBE_DB_PASSWORD" -e "USE $ROUNDCUBE_DB_NAME;" 2>/dev/null; then
        log_info "Roundcube database connection successful"
    else
        log_warning "Roundcube database connection failed, reinitializing..."
        local CURRENT_DIR=$(pwd)
        cd /var/www/html/roundcube
        ./bin/initdb.sh --dir=./SQL --create 2>/dev/null || true
        cd "$CURRENT_DIR" 2>/dev/null || true
    fi

    local admin_exists=$(mysql -u "$ROUNDCUBE_DB_USER" -p"$ROUNDCUBE_DB_PASSWORD" -e "SELECT username FROM $ROUNDCUBE_DB_NAME.users WHERE username='admin';" 2>/dev/null | grep -c "admin")

    if [ "$admin_exists" -eq 0 ]; then
        log_warning "Admin user not found, creating..."
        add_roundcube_user "admin" "$(openssl rand -base64 12)" 1000
    fi

    return 0
}

