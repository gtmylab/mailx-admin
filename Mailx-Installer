    fi
}

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

install_binary_from_url() {
    local url=$1
    local local_path=$2
    local target=$3
    local expected_name=$4
    local checksums_url=$5

    if [ -f "$local_path" ] && [ -s "$local_path" ]; then
        log_info "Using local binary at $local_path for $expected_name"
        install -m 0755 "$local_path" "$target"
        return 0
    fi

    log_info "Downloading $expected_name from $url"
    if ! retry_command "wget -q --timeout=60 --tries=3 -O ${target}.tmp $url"; then
        log_error "Failed to download $expected_name"
        rm -f "${target}.tmp"
        return 1
    fi

    if [ ! -s "${target}.tmp" ]; then
        log_error "Downloaded $expected_name is empty"
        rm -f "${target}.tmp"
        return 1
    fi

    if ! head -c 4 "${target}.tmp" | grep -q $'\x7fELF'; then
        log_warning "$expected_name does not look like a Linux ELF binary — continuing anyway"
    fi

    if [ -n "$checksums_url" ]; then
        local expected_sha=""
        expected_sha=$(wget -qO- --timeout=30 "$checksums_url" 2>/dev/null | \
            awk -v n="$expected_name" '$2 == n || $2 == "*" n { print $1; exit }')

        if [ -z "$expected_sha" ]; then
            log_warning "No checksum for $expected_name in $checksums_url - skipping verification"
        else
            local actual_sha=""
            actual_sha=$(sha256sum "${target}.tmp" 2>/dev/null | awk '{ print $1 }')
            if [ "$actual_sha" != "$expected_sha" ]; then
                log_error "Checksum mismatch for $expected_name"
                log_error "  expected: $expected_sha"
                log_error "  actual:   $actual_sha"
                rm -f "${target}.tmp"
                return 1
            fi
            log_info "Checksum verified for $expected_name (sha256 ${actual_sha:0:12}...)"
        fi
    fi

    mv "${target}.tmp" "$target"
    chmod 0755 "$target"
    return 0
}

# ============================================================================
# Enhanced Error Handling and Retry Logic
# ============================================================================

hide_output() {
    local OUTPUT=$(mktemp)
    set +e
    "$@" &> "$OUTPUT"
    local E=$?
    set -e

    if [ $E != 0 ]; then
        if grep -q "Could not resolve host\|Connection refused\|Connection timed out\|Network is unreachable" "$OUTPUT" 2>/dev/null; then
            log_warning "Network error detected: $(head -1 "$OUTPUT")"
            rm -f "$OUTPUT"
            return 1
        elif grep -q "dpkg was interrupted\|dpkg --configure -a" "$OUTPUT" 2>/dev/null; then
            log_warning "Package manager interrupted. Running dpkg --configure -a..."
            dpkg --configure -a
            rm -f "$OUTPUT"
            return 1
        else
            log_error "FAILED: $*"
            echo "----------------------------------------"
            cat "$OUTPUT"
            echo "----------------------------------------"
            if grep -q "Unable to locate package" "$OUTPUT" 2>/dev/null; then
                log_warning "A package name is not provided by this release's repositories (Debian/Ubuntu rename sub-packages between releases)."
            fi
            rm -f "$OUTPUT"
            exit $E
        fi
    fi
    rm -f "$OUTPUT"
    return 0
}

retry_command() {
    local max_attempts=7
    local attempt=1
    local delay=10
    local command="$@"

    while [ $attempt -le $max_attempts ]; do
        if eval "$command" 2>&1; then
            return 0
        fi

        log_warning "Command failed (attempt $attempt/$max_attempts). Retrying in $delay seconds..."
        sleep $delay
        attempt=$((attempt + 1))
        delay=$((delay * 2))
    done

    log_error "Command failed after $max_attempts attempts: $command"
    return 1
}

apt_get_quiet() {
    DEBIAN_FRONTEND=noninteractive hide_output apt-get -y -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confnew" "$@"
}

apt_package_candidates() {
    case "$1" in
        dovecot-lmtp)         echo "dovecot-lmtpd" ;;
        dovecot-managesieved) echo "dovecot-managesieved dovecot-managesieve" ;;
        *)                    echo "$1" ;;
    esac
}

apt_package_available() {
    apt-cache show "$1" >/dev/null 2>&1
}

resolve_apt_package() {
    local candidate
    for candidate in $(apt_package_candidates "$1"); do
        if apt_package_available "$candidate"; then
            echo "$candidate"
            return 0
        fi
    done
    return 1
}

APT_INDEX_REFRESHED=0

refresh_apt_index_once() {
    [ "$APT_INDEX_REFRESHED" -eq 1 ] && return 0
    APT_INDEX_REFRESHED=1
    log_info "Refreshing package index (apt-get update)..."
    DEBIAN_FRONTEND=noninteractive apt-get -qq update >/dev/null 2>&1 || true
}

apt_install() {
    local pkg resolved
    local -a wanted=() unresolved=()

    for pkg in "$@"; do
        if resolved="$(resolve_apt_package "$pkg")"; then
            wanted+=("$resolved")
        else
            unresolved+=("$pkg")
        fi
    done

    if [ ${#unresolved[@]} -gt 0 ]; then
        refresh_apt_index_once
        for pkg in "${unresolved[@]}"; do
            if resolved="$(resolve_apt_package "$pkg")"; then
                wanted+=("$resolved")
            else
                wanted+=("$pkg")
            fi
        done
    fi

    log_info "Installing packages: ${wanted[*]}"
    retry_command apt_get_quiet install "${wanted[@]}"
}

restart_service() {
    log_info "Restarting service: $1"
    hide_output service "$1" restart
}

