# ============================================================================
# Main menu
# ============================================================================

main_menu() {
    while true; do
        clear
        echo -e "${BLUE}"
        echo "╔══════════════════════════════════════════════════════════════════╗"
        echo "║         MailX Server Console — Debian / Ubuntu Mail Stack        ║"
        echo "╚══════════════════════════════════════════════════════════════════╝"
        echo -e "${NC}"

        local domain hostname
        domain=$(_mailx_domain)
        hostname=$(_mailx_hostname)

        echo -n "  MailX      : "
        if _mailx_is_installed; then
            echo -ne "${GREEN}INSTALLED${NC}"
        else
            echo -ne "${RED}NOT INSTALLED${NC}"
        fi
        if [ -n "$domain" ]; then
            echo -e "   domain: ${BOLD}${domain}${NC}"
        else
            echo ""
        fi
        [ -n "$hostname" ] && echo "  Hostname   : ${hostname}"

        echo -n "  Services   : "
        local svc list=""
        for svc in postfix dovecot apache2 mysql opendkim mailx-admin; do
            if _svc_active "$svc"; then
                list+="${GREEN}${svc}${NC} "
            elif _svc_known "$svc"; then
                list+="${YELLOW}${svc}${NC} "
            else
                list+="${RED}${svc}${NC} "
            fi
        done
        echo -e "$list"

        echo -n "  Apps       : "
        local apps=""
        if _dir_present /var/www/html/roundcube;  then apps+="${GREEN}roundcube${NC} ";  else apps+="${RED}roundcube${NC} "; fi
        if _dir_present /var/www/html/phpmyadmin; then apps+="${GREEN}phpmyadmin${NC} "; else apps+="${RED}phpmyadmin${NC} "; fi
        if _dir_present /var/www/html/mailx;      then apps+="${GREEN}mailx${NC} ";      else apps+="${RED}mailx${NC} "; fi
        if [ -x "$ADMIN_BINARY_PATH" ];           then apps+="${GREEN}admin${NC}";       else apps+="${RED}admin${NC}"; fi
        echo -e "$apps"

        echo -n "  SSL        : $(_ssl_expiry_summary)   "
        echo -n "  UFW        : "
        if ! _ufw_exists; then
            echo -e "${RED}not installed${NC}"
        elif _ufw_active; then
            echo -e "${GREEN}active${NC}"
        else
            echo -e "${YELLOW}inactive${NC}"
        fi
        echo "  Log        : $LOG_FILE"
        echo ""

        echo -e "${BOLD}  INSTALLATION${NC}"
        echo "    1)  Install MailX"
        echo "    2)  Show installation status"
        echo "    3)  Cleanup state (reset install stages)"
        echo "    4)  Full uninstall (MailX + mail stack)"
        echo "    5)  Uninstall Roundcube only"
        echo ""
        echo -e "${BOLD}  USER & MAIL${NC}"
        echo "    6)  Add MailX user (mailbox)"
        echo "    7)  Send a test mail"
        echo ""
        echo -e "${BOLD}  DOMAIN & POSTFIX${NC}"
        echo "    8)  Change domain / hostname"
        echo "    9)  Add email domain"
        echo "   10)  Remove email domain"
        echo "   11)  Change SMTP port (add custom)"
        echo "   12)  Repair Postfix configuration"
        echo ""
        echo -e "${BOLD}  DNS / DKIM${NC}"
        echo "   13)  View DKIM / DNS records"
        echo "   14)  Resend DKIM / DNS records to email"
        echo ""
        echo -e "${BOLD}  SSL / CERTIFICATES${NC}"
        echo "   15)  View SSL certificate details"
        echo "   16)  Renew SSL certificates now"
        echo "   17)  Configure SSL auto-renewal & notifications"
        echo "   18)  Enable SSL on webmail (Roundcube)"
        echo ""
        echo -e "${BOLD}  ADMIN PANEL${NC}"
        echo "   19)  Show admin panel URL & credentials"
        echo "   20)  Restart admin panel"
        echo "   21)  Repair admin panel web access"
        echo "   22)  Update mailx-admin to latest release"
        echo ""
        echo -e "${BOLD}  ROUNDCUBE${NC}"
        echo "   23)  Setup Composer & Roundcube user"
        echo "   24)  Install Roundcube plugins"
        echo ""
        echo -e "${BOLD}  FIREWALL (UFW)${NC}"
        echo "   25)  Manage UFW ports (list / add / remove / ranges)"
        echo ""
        echo "    0)  Exit"
        echo ""
        read -p "Select option: " choice
        case "$choice" in
            1)  menu_install_wizard ;;
            2)  menu_show_status ;;
            3)  menu_cleanup_state ;;
            4)  menu_uninstall_all ;;
            5)  menu_uninstall_roundcube ;;
            6)  menu_add_user ;;
            7)  menu_send_test ;;
            8)  menu_change_domain ;;
            9)  menu_add_domain ;;
            10) menu_remove_domain ;;
            11) menu_change_smtp_port ;;
            12) menu_repair_postfix ;;
            13) menu_show_dkim ;;
            14) menu_resend_dkim ;;
            15) menu_show_ssl ;;
            16) menu_renew_ssl ;;
            17) menu_configure_ssl_autorenewal ;;
            18) menu_enable_webmail_ssl ;;
            19) menu_show_admin_panel ;;
            20) menu_restart_admin_panel ;;
            21) menu_repair_admin_web ;;
            22) menu_update_mailx_admin ;;
            23) menu_setup_composer ;;
            24) menu_install_plugins ;;
            25) menu_firewall ;;
            0)  echo "Exiting."; exit 0 ;;
            *)  log_warning "Invalid option: '$choice'"; sleep 1 ;;
        esac
    done
}

# ============================================================================
# Entrypoint
# ============================================================================

if [ "$(id -u)" != "0" ]; then
    log_error "This script must be run as root."
    exit 1
fi

# Non-interactive update shortcut: `./Mailx-Installer update` (or --update)
if [ "$1" = "update" ] || [ "$1" = "--update" ]; then
    update_mailx_admin
    exit $?
fi

main_menu
